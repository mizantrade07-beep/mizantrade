# Deploy credentials — copy to .env.deploy and fill in.
# .env.deploy is git-ignored. Never commit or share it.
#
# Create it automatically:  npm run deploy:setup

# InMotion cPanel -> SSH Access (server 213.165.243.42)
SSH_HOST=213.165.243.42
SSH_PORT=2222
SSH_USER=cpanel-username

# Pick ONE auth method.
# 1) Key auth (recommended): cPanel -> SSH Access -> Manage SSH Keys -> Import Key,
#    paste the PUBLIC key from ~/.ssh/mizantrade_deploy_ed25519.pub, then Authorize it.
SSH_KEY_PATH=C:\Users\Admin_Pc\.ssh\mizantrade_deploy_ed25519
# 2) Password auth: uncomment SSH_PASS and comment out SSH_KEY_PATH.
# SSH_PASS=your-cpanel-password

# Optional. Leave empty to auto-detect the folder that holds server.js + package.json.
APP_DIR=
# Optional health endpoint polled after restart.
HEALTH_URL=https://www.mizantrade.com/health
