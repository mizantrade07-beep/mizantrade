<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/seo') %>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
        body { background: #f4f6f9; color: #333; }
        .container { max-width: 1600px; margin: 20px auto; padding: 0 20px; }

        /* Breadcrumb */
        .breadcrumb { font-size: 13px; color: #666; margin-bottom: 15px; display: flex; align-items: center; gap: 6px; }
        .breadcrumb a { color: #333; text-decoration: none; }
        .breadcrumb a:hover { color: #ef4a23; }

        /* Full Width Layout */
        .single-product-layout { display: flex; flex-direction: column; gap: 20px; }

        /* Top Product Overview Card */
        .product-top-card { background: #fff; padding: 30px; border-radius: 6px; border: 1px solid #e5e5e5; display: flex; gap: 40px; }
        
        /* Advanced Gallery Section */
        .product-gallery-col { flex: 1.2; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
        .gallery-container { display: flex; gap: 20px; }
        .product-side-banner { border: 1px solid #e5e5e5; border-radius: 6px; background: #fff; padding: 8px; }
        .product-side-banner a { display: block; }
        .product-side-banner img { width: 100%; height: auto; display: block; border-radius: 4px; }
        .thumbnail-list { display: flex; flex-direction: column; gap: 20px; max-height: 450px; overflow-y: auto; padding-right: 5px; }
        .thumb-img { width: 50px; height: 50px; object-fit: contain; border: 1px solid #ddd; border-radius: 4px; cursor: pointer; padding: 2px; transition: 0.2s; background: #fff; }
        .thumb-img:hover, .thumb-img.active { border-color: #ef4a23; box-shadow: 0 0 5px rgba(239, 74, 35, 0.2); }
        .main-display-img { flex: 1; text-align: center; display: flex; align-items: center; justify-content: center; position: relative; border: 1px solid #f0f0f0; border-radius: 6px; background: #fff; padding: 2px; overflow: hidden; cursor: zoom-in; }
        .main-display-img img { max-width: 100%; height: 420px; object-fit: contain; transition: transform 0.25s ease; will-change: transform; }
        .main-display-img.zoom-active img { transform: scale(2); }

        /* Image Lightbox */
        .p-lightbox { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(8, 22, 33, 0.94); z-index: 9999; display: none; align-items: center; justify-content: center; }
        .p-lightbox.open { display: flex; }
        .p-lightbox img { max-width: 90vw; max-height: 80vh; object-fit: contain; background: #fff; border-radius: 6px; padding: 8px; }
        .plb-btn { position: absolute; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.35); background: rgba(255,255,255,0.12); color: #fff; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
        .plb-btn:hover { background: rgba(255,255,255,0.25); }
        .plb-close { top: 18px; right: 18px; }
        .plb-prev { left: 14px; top: 50%; transform: translateY(-50%); }
        .plb-next { right: 14px; top: 50%; transform: translateY(-50%); }

        /* Product Info Column */
        .product-info-container { flex: 1.5; }
        .product-title { font-size: 18px; font-weight: 700; color: #081621; margin-bottom: 10px; line-height: 1.4; }
        
        .rating-sku { display: flex; align-items: center; gap: 20px; font-size: 13px; color: #666; margin-bottom: 15px; flex-wrap: wrap; }
        .stars { color: #ffc107; font-weight: 600; letter-spacing: 1px; }
        .stars span { color: #2e7d32; }

        /* Price Box */
        .price-box-ryans { background: #f2f4f8; padding: 18px; border-radius: 6px; margin-bottom: 20px; border-left: 4px solid #ef4a23; }
        .special-price-label { font-size: 12px; color: #555; text-transform: uppercase; font-weight: 600; }
        .special-price { font-size: 28px; font-weight: 700; color: #ef4a23; margin: 4px 0; }
        .extra-offer-text { font-size: 13px; color: #7b1fa2; font-weight: 600; margin-bottom: 8px; }
        .regular-price-box { font-size: 13px; color: #666; }
        .reg-strike { text-decoration: line-through; color: #999; }
        .reward-note {
            display: inline-flex; align-items: center; gap: 7px; flex-wrap: wrap;
            margin-top: 10px; padding: 6px 11px; border-radius: 6px;
            background: #eaf7ee; border: 1px solid #bfe8cd; color: #1f8a3b;
            font-size: 12.5px; font-weight: 600;
        }
        .reward-note .fa-gift { font-size: 11px; }
        .reward-note .reward-worth { color: #4b7a5a; font-weight: 600; font-size: 11.5px; }

        .quick-overview { font-size: 13px; color: #444; border-top: 1px solid #eee; padding-top: 15px; margin-bottom: 20px; }
        .quick-overview ul { padding-left: 18px; margin-top: 6px; }
        .quick-overview li { margin-bottom: 5px; }

        .cart-qty-row { display: flex; gap: 12px; align-items: center; margin-bottom: 25px; flex-wrap: wrap; }
        .qty-input { width: 70px; padding: 10px; text-align: center; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; outline: none; }
        .qty-input:focus { border-color: #ef4a23; }
        .add-to-cart-btn { background: #82b440; color: #fff; border: none; padding: 12px 30px; font-size: 15px; font-weight: 600; border-radius: 4px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; }
        .add-to-cart-btn:hover { background: #719d37; }
        .buy-now-btn { background: #ef4a23; color: #fff; border: none; padding: 12px 26px; font-size: 15px; font-weight: 600; border-radius: 4px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: 0.2s; }
        .buy-now-btn:hover { background: #d63f1b; }
        .add-to-cart-btn:focus-visible, .buy-now-btn:focus-visible { outline: 2px solid #081621; outline-offset: 2px; }
        .action-icon-btn { background: #fff; border: 1px solid #ddd; width: 42px; height: 42px; border-radius: 4px; cursor: pointer; font-size: 14px; color: #555; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: 0.2s; }
        .action-icon-btn:hover { border-color: #999; color: #000; background: #fafafa; }

        /* Social Share Row */
        .social-share-row { display: flex; gap: 10px; align-items: center; border-top: 1px solid #eee; padding-top: 18px; font-size: 13px; color: #666; flex-wrap: wrap; }
        .social-icon { width: 32px; height: 32px; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #fff; text-decoration: none; font-size: 13px; transition: 0.2s; }
        .social-icon:hover { opacity: 0.85; transform: translateY(-1px); }

        /* Specs & Details Tabs Card */
        .specs-details-card { background: #fff; border: 1px solid #e5e5e5; border-radius: 6px; padding: 30px; }
        .tab-nav { display: flex; gap: 30px; border-bottom: 2px solid #eee; margin-bottom: 25px; overflow-x: auto; }
        .tab-nav-btn { background: none; border: none; font-size: 16px; font-weight: 600; color: #666; padding-bottom: 12px; cursor: pointer; position: relative; white-space: nowrap; }
        .tab-nav-btn.active { color: #000; }
        .tab-nav-btn.active::after { content: ''; position: absolute; bottom: -2px; left: 0; width: 100%; height: 3px; background: #ef4a23; }

        .tab-pane-content { display: none; font-size: 14px; line-height: 1.7; color: #333; }
        .tab-pane-content.active { display: block; }

        /* Specs Table Style */
        .specs-table { width: 100%; border-collapse: collapse; font-size: 14px; }
        .specs-table th, .specs-table td { padding: 14px 18px; border-bottom: 1px solid #eee; text-align: left; vertical-align: middle; }
        .specs-table th { background: #f9f9f9; color: #333; width: 25%; font-weight: 600; }
        .specs-group-title { background: #f1f3f5; font-weight: 700; color: #081621; }

        /* Auto-adjust images / videos / embeds inside Specifications & Quick Overview
           (pasted rich-text HTML often carries fixed inline widths, so cap everything) */
        .rte-output *, .quick-overview * { max-width: 100% !important; }
        .rte-output img, .quick-overview img,
        .rte-output video, .quick-overview video { max-width: 100% !important; height: auto !important; }
        .rte-output iframe, .quick-overview iframe { max-width: 100% !important; width: 100% !important; height: auto !important; aspect-ratio: 16 / 9; }
        .rte-output table, .quick-overview table { max-width: 100% !important; width: 100% !important; table-layout: auto !important; }
        .rte-output, .quick-overview { overflow-wrap: break-word; }
        .rte-output { overflow-x: auto; }

        /* Similar Products */
        .similar-products-card { background: #fff; border: 1px solid #e5e5e5; border-radius: 6px; padding: 24px 30px 30px; }
        .similar-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 2px solid #eee; margin-bottom: 20px; padding-bottom: 12px; }
        .similar-head h2 { font-size: 20px; font-weight: 700; color: #081621; display: flex; align-items: center; gap: 10px; }
        .similar-head h2 i { color: #ef4a23; }
        .similar-head a { color: #ef4a23; font-weight: 600; font-size: 13px; text-decoration: none; white-space: nowrap; }
        .similar-head a:hover { text-decoration: underline; }
        .similar-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
        .similar-grid .product-card { flex: 1 1 165px; min-width: 0; max-width: 210px; }

        @media(max-width: 1100px) {
            .similar-grid .product-card { flex: 1 1 30%; max-width: none; }
        }

        @media(max-width: 767px) {
            .similar-products-card { padding: 18px 12px; }
            .similar-grid { gap: 10px; }
            .similar-grid .product-card { flex: 1 1 calc(50% - 5px); max-width: none; }
            .similar-head h2 { font-size: 16px; }
        }

        @media(max-width: 992px) {
            .product-top-card { flex-direction: column; }
            .gallery-container { flex-direction: column-reverse; }
            .thumbnail-list { flex-direction: row; max-height: none; overflow-x: auto; }
            .product-title { font-size: 17px; }
            .specs-table { font-size: 13px; }
            .specs-table th, .specs-table td { padding: 12px 14px; }
        }

        @media(max-width: 767px) {
            .product-top-card { padding: 14px; gap: 14px; }
            .main-display-img { padding: 2px; }
            .main-display-img img { height: 240px; }
            .thumb-img { width: 50px; height: 50px; }
            .product-title { font-size: 16px; }
            .specs-table { font-size: 13px; }
            .specs-details-card { padding: 18px 12px; }
            .tab-nav { gap: 18px; }
            .tab-nav-btn { font-size: 14px; }

            /* Purchase actions: quantity + Add to Cart + icons on one row, Buy Now full width below */
            .cart-qty-row { gap: 10px; }
            .qty-input { flex: 0 0 60px; width: 60px; }
            .add-to-cart-btn { flex: 1 1 0; min-width: 0; padding: 12px 10px; font-size: 14px; justify-content: center; }
            .buy-now-btn { order: 9; flex: 1 1 100%; padding: 12px 10px; font-size: 14px; }
            .cart-qty-row .action-icon-btn { flex: 0 0 40px; width: 40px; height: 40px; }

            /* Stack spec rows as blocks so nothing overflows the screen */
            .specs-table, .specs-table tbody { display: block; width: 100%; }
            .specs-table tr { display: block; width: 100%; }
            .specs-table th, .specs-table td { display: block; width: 100%; box-sizing: border-box; text-align: left; }
            .specs-table th { border-bottom: none; padding-bottom: 4px; }
            .specs-table td { padding-top: 2px; }
        }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <div class="container">
        <!-- Breadcrumb -->
        <div class="breadcrumb">
            <a href="/"><i class="fa-solid fa-house"></i></a> / 
            <% if (typeof categoryTrail !== 'undefined' && categoryTrail && categoryTrail.length) { %>
                <% categoryTrail.forEach(function (node) { %>
                    <a href="/category/<%= node.slug %>"><%= node.name %></a> /
                <% }); %>
            <% } else if (typeof categorySlug !== 'undefined' && categorySlug) { %>
                <a href="/category/<%= categorySlug %>"><%= product.mainCategory || 'Accessories' %></a> / 
            <% } else { %>
                <a href="/shop"><%= product.mainCategory || 'Accessories' %></a> / 
            <% } %>
            <span><%= product.title %></span>
        </div>

        <div class="single-product-layout">
            <!-- Top Overview Box & Gallery -->
            <div class="product-top-card">
                <div class="product-gallery-col">
                <div class="gallery-container">
                    <!-- Product Gallery Thumbnails -->
                    <div class="thumbnail-list">
                        <% if (product.mainImage) { %>
                            <img src="<%= optimizeImage(product.mainImage, 200) %>" data-full="<%= optimizeImage(product.mainImage, 1200) %>" class="thumb-img active" onclick="changeImage(this)" alt="Main Image" loading="lazy" decoding="async">
                        <% } %>
                        
                        <% 
                            let galleryImages = product.galleryImages || product.gallery || [];
                        %>
                        <% if (Array.isArray(galleryImages) && galleryImages.length > 0) { %>
                            <% galleryImages.forEach(img => { %>
                                <% if (img) { %>
                                    <img src="<%= optimizeImage(img, 200) %>" data-full="<%= optimizeImage(img, 1200) %>" class="thumb-img" onclick="changeImage(this)" alt="Gallery Image" loading="lazy" decoding="async">
                                <% } %>
                            <% }) %>
                        <% } %>
                    </div>
                    <!-- Main Display Image Viewer -->
                    <div class="main-display-img">
                        <img id="mainProductImg" src="<%= optimizeImage(product.mainImage || (galleryImages && galleryImages[0]), 1200) || 'https://via.placeholder.com/400' %>" alt="<%= product.title %>" decoding="async" fetchpriority="high">
                    </div>
                </div>

                <%
                    var pbGlobal = (typeof site !== 'undefined' && site && site.productBanner) ? site.productBanner : null;
                    var pbUseGlobal = !product.bannerImage && pbGlobal && pbGlobal.enabled && pbGlobal.image;
                    var pbImg = product.bannerImage || (pbUseGlobal ? pbGlobal.image : '');
                    var pbUrl = product.bannerImage ? (product.bannerLink || '') : (pbUseGlobal ? (pbGlobal.link || '') : '');
                %>
                <% if (pbImg) { %>
                    <div class="product-side-banner">
                        <% if (pbUrl) { %>
                            <a href="<%= pbUrl %>"<% if (/^https?:/i.test(pbUrl)) { %> target="_blank" rel="noopener"<% } %>>
                        <% } %>
                            <img src="<%= optimizeImage(pbImg, 900) %>" alt="Special offer banner" loading="lazy" decoding="async">
                        <% if (pbUrl) { %></a><% } %>
                    </div>
                <% } %>
                </div>

                <div class="product-info-container">
                    <h1 class="product-title"><%= product.title %></h1>
                    
                    <% 
                        const approvedReviews = product.reviews ? product.reviews.filter(r => r.isApproved) : [];
                        let avgRating = 0;
                        if (approvedReviews.length > 0) {
                            const totalRating = approvedReviews.reduce((sum, r) => sum + Number(r.rating), 0);
                            avgRating = (totalRating / approvedReviews.length).toFixed(1);
                        }
                    %>

                    <div class="rating-sku">
                        <div class="stars">
                            <% let starCount = Math.round(avgRating || 5); %>
                            <% for(let i=0; i<5; i++) { %>
                                <i class="<%= i < starCount ? 'fa-solid' : 'fa-regular' %> fa-star"></i>
                            <% } %>
                            <span style="font-weight: 600; margin-left: 4px;"><%= avgRating > 0 ? avgRating : '5.0' %></span>
                            <span style="color: #666; font-size: 12px; font-weight: 400; margin-left: 4px;">(<%= approvedReviews.length %> reviews)</span>
                        </div>
                    </div>

                    <!-- Price Box -->
                    <div class="price-box-ryans">
                        <div class="special-price-label">Special Price</div>
                        <div class="special-price">
                            <% if (!product.callForPrice && (product.salePrice || product.regularPrice)) { %>
                                ৳ <%= (product.salePrice || product.regularPrice).toLocaleString('en-US') %>
                            <% } else { %>
                                <a href="tel:<%= site.hotline %>" style="color:#82b440; font-size:20px;">
                                    <i class="fa-solid fa-phone-volume"></i> Call for Price: <%= site.hotline %>
                                </a>
                            <% } %>
                        </div>
                        
                        <% if (product.regularPrice && product.salePrice && product.regularPrice > product.salePrice) { %>
                            <div class="extra-offer-text">Save Extra Tk <%= (product.regularPrice - product.salePrice).toLocaleString() %> on various offer</div>
                            <div class="regular-price-box">Regular Price: <span class="reg-strike">Tk <%= product.regularPrice.toLocaleString() %></span></div>
                        <% } %>

                        <% if (Number(product.rewardPoints) > 0) { %>
                            <%
                                var rewardCfg = (typeof site !== 'undefined' && site.rewards) ? site.rewards : {};
                                var rewardValue = Number(rewardCfg.pointValue === undefined ? 1 : rewardCfg.pointValue) || 0;
                            %>
                            <div class="reward-note">
                                <i class="fa-solid fa-gift"></i>
                                Earn <strong><%= Number(product.rewardPoints).toLocaleString('en-US') %></strong>
                                <%= rewardCfg.label || 'Reward Points' %> on this product
                                <% if (rewardValue > 0) { %>
                                    <span class="reward-worth">(≈ ৳<%= (Number(product.rewardPoints) * rewardValue).toLocaleString('en-US', { maximumFractionDigits: 2 }) %>)</span>
                                <% } %>
                            </div>
                        <% } %>
                    </div>

                    <div class="quick-overview">
                        <strong>Quick Overview</strong>
                        <%- optimizeHtml(product.shortDesc, 1200) || '<ul><li>High performance quality product</li><li>Reliable dealer stock</li></ul>' %>
                    </div>

                    <!-- Functional Add to Cart Form, Compare, and Wishlist Links -->
                    <form action="/cart/add/<%= product._id %>" method="POST" class="cart-qty-row" id="add-to-cart-form">
                        <input type="number" name="quantity" value="1" min="1" class="qty-input">
                        <button type="submit" class="add-to-cart-btn" data-id="<%= product._id %>"><i class="fa-solid fa-cart-shopping"></i> Add to Cart</button>
                        <button type="submit" class="buy-now-btn" formaction="/cart/buy-now/<%= product._id %>" data-id="<%= product._id %>"><i class="fa-solid fa-bolt"></i> Buy Now</button>
                        <a href="/wishlist/add/<%= product._id %>" class="action-icon-btn wishlist-btn" data-id="<%= product._id %>" title="Wishlist"><i class="fa-regular fa-heart"></i></a>
                        <a href="/compare/add/<%= product._id %>" class="action-icon-btn compare-btn js-compare" data-id="<%= product._id %>" title="Add to Compare"><i class="fa-solid fa-code-compare"></i></a>
                    </form>

                    <!-- Social Share & Utility Links -->
                    <div class="social-share-row">
                        <a href="/pages/payment-methods" class="action-icon-btn" style="width: 34px; height: 34px; font-size: 12px;" title="Payment Method"><i class="fa-solid fa-credit-card"></i></a>
                        <a href="/pages/shipping-info" class="action-icon-btn" style="width: 34px; height: 34px; font-size: 12px;" title="Shipping"><i class="fa-solid fa-truck"></i></a>
                        <span style="margin-left: auto;">Share:</span>
                        <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(product.title) %>" target="_blank" class="social-icon" style="background: #25d366;" title="Share on WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
                        <a href="mailto:?subject=<%= encodeURIComponent(product.title) %>" class="social-icon" style="background: #ea4335;" title="Share via Email"><i class="fa-solid fa-envelope"></i></a>
                        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent('https://yourdomain.com/product/' + product._id) %>" target="_blank" class="social-icon" style="background: #1877f2;" title="Share on Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(product.title) %>" target="_blank" class="social-icon" style="background: #000;" title="Share on X"><i class="fa-brands x-twitter">𝕏</i></a>
                        <a href="javascript:window.print();" class="social-icon" style="background: #4caf50;" title="Print Page"><i class="fa-solid fa-print"></i></a>
                    </div>
                </div>
            </div>

            <!-- Tabs Card (Specifications, Details, Customer Questions, Reviews) -->
            <div class="specs-details-card">
                <div class="tab-nav">
                    <button class="tab-nav-btn active" onclick="switchRyansTab(event, 'specsTabContent')">Specifications</button>
                    <button class="tab-nav-btn" onclick="switchRyansTab(event, 'questionsTabContent')">Customer Questions</button>
                    <button class="tab-nav-btn" onclick="switchRyansTab(event, 'reviewsTabContent')">Review (<%= approvedReviews.length %>)</button>
                </div>

                <!-- 1. Specifications (+ product description) -->
                <div id="specsTabContent" class="tab-pane-content active">
                    <% if (product.specs && product.specs.length) { %>
                        <table class="specs-table">
                            <tr><th colspan="2" class="specs-group-title">Key Specifications</th></tr>
                            <% product.specs.forEach(function (spec) { %>
                                <tr><th><%= spec.key %></th><td><%= spec.value %></td></tr>
                            <% }) %>
                        </table>
                    <% } %>

                    <div class="rte-output" style="margin-top:22px; font-size:14px; color:#44505c; line-height:1.7;">
                        <%- optimizeHtml(product.longDesc, 1200) || '<p>No detailed description has been added for this product yet. Feel free to contact us directly for wholesale inquiries.</p>' %>
                    </div>
                </div>

                <!-- 2. Customer Questions -->
                <div id="questionsTabContent" class="tab-pane-content">
                    <% var approvedQuestions = (product.questions || []).filter(function (q) { return q.isApproved; }); %>
                    <h3 style="font-size: 16px; margin-bottom: 15px; color: #081621;">Questions about this product (<%= approvedQuestions.length %>)</h3>
                    <% if (approvedQuestions.length > 0) { %>
                        <% approvedQuestions.forEach(q => { %>
                            <div style="border-bottom: 1px solid #eee; padding: 12px 0;">
                                <strong>Q: <%= q.question %></strong> <span style="font-size: 11px; color: #888;">- <%= q.name %></span>
                                <p style="font-size: 13px; color: #555; margin-top: 6px; background: #f9f9f9; padding: 10px; border-radius: 4px;"><strong>Answer:</strong> <%= q.answer || 'Admin reply pending.' %></p>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="font-size: 13px; color: #666; margin-bottom: 15px;">No questions have been asked about this product yet. You can submit your question below:</p>
                    <% } %>

                    <form action="/product/question/<%= product._id %>" method="POST" style="margin-top: 20px; display: flex; flex-direction: column; gap: 12px; max-width: 600px;">
                        <input type="text" name="name" placeholder="Your Name" required style="padding: 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px;">
                        <textarea name="question" placeholder="Write your question about this product..." rows="3" required style="padding: 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px;"></textarea>
                        <button type="submit" style="background: #081621; color: #fff; border: none; padding: 10px 20px; border-radius: 4px; font-size: 13px; cursor: pointer; width: fit-content; font-weight: 600;">Ask Question</button>
                    </form>
                </div>

                <!-- 4. Customer Reviews -->
                <div id="reviewsTabContent" class="tab-pane-content">
                    <h3 style="font-size: 16px; margin-bottom: 15px; color: #081621;">Verified Customer Reviews</h3>
                    <% if (approvedReviews.length > 0) { %>
                        <% approvedReviews.forEach(rev => { %>
                            <div style="border-bottom: 1px solid #eee; padding: 12px 0;">
                                <strong><%= rev.name %></strong> - <span style="color: #ffc107;">★ <%= rev.rating %>/5</span>
                                <p style="font-size: 13px; color: #555; margin-top: 4px;"><%= rev.comment %></p>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: #666; font-size: 13px; margin-bottom: 15px;">No approved reviews available for this product yet.</p>
                    <% } %>

                    <form action="/product/review/<%= product._id %>" method="POST" style="margin-top: 25px; border-top: 1px solid #eee; padding-top: 20px; display: flex; flex-direction: column; gap: 12px; max-width: 600px;">
                        <h4 style="font-size: 15px; color: #333;">Write a Review</h4>
                        <div style="display: flex; gap: 15px;">
                            <input type="text" name="name" placeholder="Your Name" required style="flex: 1; padding: 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px;">
                            <select name="rating" style="padding: 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px;">
                                <option value="5">5 Star (Excellent)</option>
                                <option value="4">4 Star (Good)</option>
                                <option value="3">3 Star (Average)</option>
                                <option value="2">2 Star (Poor)</option>
                                <option value="1">1 Star (Bad)</option>
                            </select>
                        </div>
                        <textarea name="comment" placeholder="Write your feedback here..." rows="3" required style="padding: 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px;"></textarea>
                        <button type="submit" style="background: #ef4a23; color: #fff; border: none; padding: 10px 20px; border-radius: 4px; font-size: 13px; cursor: pointer; width: fit-content; font-weight: 600;">Submit Review (Pending Approval)</button>
                    </form>
                </div>
            </div>

            <% var similarList = (typeof similarProducts !== 'undefined' && Array.isArray(similarProducts)) ? similarProducts : []; %>
            <% if (similarList.length > 0) { %>
                <section class="similar-products-card">
                    <div class="similar-head">
                        <h2><i class="fa-solid fa-layer-group"></i> Similar Products</h2>
                        <a href="<%= typeof categorySlug !== 'undefined' && categorySlug ? '/category/' + categorySlug : '/shop' %>">
                            View All <i class="fa-solid fa-angle-right"></i>
                        </a>
                    </div>

                    <div class="similar-grid">
                        <% similarList.forEach(function (similar) { %>
                            <%- include('partials/productCard', { product: similar }) %>
                        <% }); %>
                    </div>
                </section>
            <% } %>
        </div>
    </div>

    <!-- Image Zoom Lightbox -->
    <div id="productLightbox" class="p-lightbox">
        <button type="button" id="plbClose" class="plb-btn plb-close" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
        <button type="button" id="plbPrev" class="plb-btn plb-prev" aria-label="Previous image"><i class="fa-solid fa-chevron-left"></i></button>
        <img id="lightboxImg" src="" alt="Product image">
        <button type="button" id="plbNext" class="plb-btn plb-next" aria-label="Next image"><i class="fa-solid fa-chevron-right"></i></button>
    </div>

    <script>
        // Gallery Thumbnail Change Script
        function changeImage(element) {
            document.getElementById('mainProductImg').src = element.getAttribute('data-full') || element.src;
            let thumbs = document.getElementsByClassName('thumb-img');
            for(let t of thumbs) { t.classList.remove('active'); }
            element.classList.add('active');
        }

        // Tab Switching Script
        function switchRyansTab(evt, tabId) {
            let panes = document.getElementsByClassName('tab-pane-content');
            for(let p of panes) { p.classList.remove('active'); }
            let btns = document.getElementsByClassName('tab-nav-btn');
            for(let b of btns) { b.classList.remove('active'); }
            document.getElementById(tabId).classList.add('active');
            evt.currentTarget.classList.add('active');
        }

        // Image hover zoom + click-to-open lightbox
        (function () {
            var stage = document.querySelector('.main-display-img');
            var img = document.getElementById('mainProductImg');
            if (!stage || !img) return;

            var thumbs = Array.prototype.slice.call(document.querySelectorAll('.thumb-img'));
            var images = thumbs.length
                ? thumbs.map(function (t) { return t.getAttribute('data-full') || t.getAttribute('src'); })
                : [img.getAttribute('src')];

            var lightbox = document.getElementById('productLightbox');
            var lbImg = document.getElementById('lightboxImg');
            var btnClose = document.getElementById('plbClose');
            var btnPrev = document.getElementById('plbPrev');
            var btnNext = document.getElementById('plbNext');
            var current = 0;

            var canHover = window.matchMedia &&
                window.matchMedia('(hover: hover) and (pointer: fine)').matches;

            if (canHover) {
                stage.addEventListener('mousemove', function (e) {
                    var r = img.getBoundingClientRect();
                    if (!r.width || !r.height) return;
                    var x = Math.min(100, Math.max(0, ((e.clientX - r.left) / r.width) * 100));
                    var y = Math.min(100, Math.max(0, ((e.clientY - r.top) / r.height) * 100));
                    img.style.transformOrigin = x + '% ' + y + '%';
                    stage.classList.add('zoom-active');
                });
                stage.addEventListener('mouseleave', function () {
                    stage.classList.remove('zoom-active');
                });
            }

            function syncMain() {
                img.src = images[current];
                thumbs.forEach(function (t, i) { t.classList.toggle('active', i === current); });
            }

            function show(step) {
                current = (current + step + images.length) % images.length;
                lbImg.src = images[current];
                syncMain();
            }

            function openLightbox() {
                var idx = images.indexOf(img.getAttribute('src'));
                current = idx === -1 ? 0 : idx;
                lbImg.src = images[current];
                lightbox.classList.add('open');
                document.body.style.overflow = 'hidden';
            }

            function closeLightbox() {
                lightbox.classList.remove('open');
                document.body.style.overflow = '';
            }

            var multi = images.length > 1;
            btnPrev.style.display = multi ? 'flex' : 'none';
            btnNext.style.display = multi ? 'flex' : 'none';

            stage.addEventListener('click', openLightbox);
            btnClose.addEventListener('click', closeLightbox);
            btnPrev.addEventListener('click', function (e) { e.stopPropagation(); show(-1); });
            btnNext.addEventListener('click', function (e) { e.stopPropagation(); show(1); });
            lightbox.addEventListener('click', function (e) {
                if (e.target === lightbox) closeLightbox();
            });
            document.addEventListener('keydown', function (e) {
                if (!lightbox.classList.contains('open')) return;
                if (e.key === 'Escape') closeLightbox();
                else if (e.key === 'ArrowLeft') show(-1);
                else if (e.key === 'ArrowRight') show(1);
            });
        })();

        // Optional AJAX functionality for Cart and Wishlist if using JSON response
        document.addEventListener('DOMContentLoaded', () => {
            const addToCartBtn = document.querySelector('.add-to-cart-btn');
            if (addToCartBtn) {
                addToCartBtn.addEventListener('click', async (e) => {
                    // যদি ফর্ম সাবমিট স্বাভাবিক নিয়মে (Page Reload) করতে চান তবে নিচের preventDefault লাইনটি বাদ দিতে পারেন।
                    // কিন্তু যদি AJAX ব্যবহার করতে চান তবে এটি রাখতে হবে।
                });
            }
        });
    </script>

    <%- include('partials/footer') %>
    <script src="/js/main.js?v=4"></script>
</body>
</html>