<!DOCTYPE html>
<html lang="bn">
<head>
    <link rel="icon" href="/images/logo.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmed - Mizan Trade</title>
</head>
<body>

    <%- include('partials/header') %>

    <div class="container" style="max-width:820px;">

        <div class="content-card" style="text-align:center; padding:40px 24px;">

            <div style="width:76px; height:76px; border-radius:50%; background:#edf7e3; display:inline-flex; align-items:center; justify-content:center; margin-bottom:18px;">
                <i class="fa-solid fa-check" style="font-size:34px; color:#82b440;"></i>
            </div>

            <h1 style="color:#081621; font-size:24px; margin-bottom:8px;">Order Placed Successfully!</h1>
            <p style="color:#777; margin-bottom:6px;">Thank you <%= order.customer.name %>, we have received your order.</p>

            <p style="margin-bottom:24px;">
                <span style="background:#081621; color:#fff; padding:6px 16px; border-radius:20px; font-weight:700; font-size:14px;">
                    Order Number: <%= order.orderNumber %>
                </span>
            </p>

            <%
                var method = order.paymentMethod;
                var info = order.paymentInfo || {};
                var walletName = method === 'bkash' ? 'bKash' : (method === 'nagad' ? 'Nagad' : (method === 'rocket' ? 'Rocket' : ''));
            %>
            <% if (walletName) { %>
                <div class="info-box" style="text-align:left;">
                    <strong><i class="fa-solid fa-mobile-screen-button" style="color:#e2136e;"></i> <%= walletName %> Payment:</strong><br>
                    TrxID: <strong><%= info.trxId || '—' %></strong><br>
                    <% if (info.receiverNumber) { %>
                        We will verify the payment sent to <strong><%= info.receiverNumber %></strong> and confirm your order by phone.
                    <% } else { %>
                        We will verify the payment and confirm your order by phone.
                    <% } %>
                </div>
            <% } else if (method === 'bank') { %>
                <div class="info-box" style="text-align:left;">
                    <strong><i class="fa-solid fa-building-columns"></i> Bank Transfer:</strong><br>
                    <% if (info.receiverBankName) { %><%= info.receiverBankName %><% } %>
                    <% if (info.receiverAccountNumber) { %>, Account: <strong><%= info.receiverAccountNumber %></strong><% } %>
                    <% if (info.receiverAccountName) { %> (<%= info.receiverAccountName %>)<% } %>
                    <% if (info.trxId) { %><br>Reference: <strong><%= info.trxId %></strong><% } %><br>
                    After transferring, please call our hotline to let us know — your order will be confirmed.
                </div>
            <% } else { %>
                <div class="info-box" style="text-align:left;">
                    <strong><i class="fa-solid fa-money-bill-wave" style="color:#82b440;"></i> Cash on Delivery:</strong><br>
                    Pay the courier when the product is delivered. We will contact you by phone shortly.
                </div>
            <% } %>

            <!-- অর্ডার সামারি -->
            <table class="data-table" style="margin-top:22px; text-align:left;">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.items.forEach(function(item) { %>
                        <tr>
                            <td><%= item.title %></td>
                            <td>৳ <%= Number(item.price).toLocaleString('en-US') %></td>
                            <td><%= item.quantity %></td>
                            <td>৳ <%= (item.price * item.quantity).toLocaleString('en-US') %></td>
                        </tr>
                    <% }); %>
                    <tr>
                        <td colspan="3" style="text-align:right;">Delivery Charge (<%= order.customer.city %>)</td>
                        <td>৳ <%= order.shippingFee.toLocaleString('en-US') %></td>
                    </tr>
                    <% if (order.discount > 0) { %>
                        <tr>
                            <td colspan="3" style="text-align:right; color:#1f8a3b;">Discount <%= order.couponCode ? '(' + order.couponCode + ')' : '' %></td>
                            <td style="color:#1f8a3b;">− ৳ <%= order.discount.toLocaleString('en-US') %></td>
                        </tr>
                    <% } %>
                    <% if (order.rewardPointsRedeemed > 0) { %>
                        <tr>
                            <td colspan="3" style="text-align:right; color:#1f8a3b;">Reward Points (<%= order.rewardPointsRedeemed %> pts)</td>
                            <td style="color:#1f8a3b;">− ৳ <%= Number(order.rewardDiscount || 0).toLocaleString('en-US') %></td>
                        </tr>
                    <% } %>
                    <% if (order.taxAmount > 0) { %>
                        <tr>
                            <td colspan="3" style="text-align:right;"><%= order.taxLabel || 'Tax' %><%= order.taxIncluded ? ' (included)' : '' %></td>
                            <td><%= order.taxIncluded ? '' : '+ ' %>৳ <%= Number(order.taxAmount).toLocaleString('en-US') %></td>
                        </tr>
                    <% } %>
                    <% if (order.paymentCharge > 0) { %>
                        <tr>
                            <td colspan="3" style="text-align:right;">Payment Charge</td>
                            <td>৳ <%= order.paymentCharge.toLocaleString('en-US') %></td>
                        </tr>
                    <% } %>
                    <tr>
                        <td colspan="3" style="text-align:right; font-weight:700;">Grand Total</td>
                        <td style="font-weight:700; color:#ef4a23;">৳ <%= order.total.toLocaleString('en-US') %></td>
                    </tr>
                    <% if (order.rewardPointsEarned > 0) { %>
                        <tr>
                            <td colspan="4" style="text-align:right; font-size:12.5px; color:#1f8a3b;">
                                <i class="fa-solid fa-gift"></i> You earned <strong><%= order.rewardPointsEarned %></strong> reward points with this order.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <div style="margin-top:26px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
                <a href="/shop" class="btn btn-primary"><i class="fa-solid fa-store"></i> Continue Shopping</a>
                <a href="tel:<%= site.hotline %>" class="btn btn-outline"><i class="fa-solid fa-phone"></i> Call Hotline</a>
            </div>

        </div>

    </div>

    <%- include('partials/footer') %>

    <script src="/js/main.js?v=4"></script>
</body>
</html>
