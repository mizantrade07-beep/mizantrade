<%
    var f = (typeof footer !== "undefined" && footer) ? footer : null;

    var fLogo = f ? f.logo : { image: "/images/logo.svg", link: "", height: 45, mobileHeight: 36 };
    var fInfo = f ? f.infoBlocks : [];
    var fCols = f ? f.columns : [];
    var fMemb = f ? f.memberships : [];
    var fIcons = f ? f.paymentIcons : [];
    var fCopy = f ? f.copyright : "";
    var fMembTitle = (f && f.membershipTitle) ? f.membershipTitle : "Membership";

    var socialMap = {
        facebook:  { icon: "fa-brands fa-facebook-f",   bg: "#1877f2" },
        youtube:   { icon: "fa-brands fa-youtube",      bg: "#ff0000" },
        instagram: { icon: "fa-brands fa-instagram",    bg: "#e1306c" },
        tiktok:    { icon: "fa-brands fa-tiktok",       bg: "#010101" },
        linkedin:  { icon: "fa-brands fa-linkedin-in",  bg: "#0a66c2" },
        whatsapp:  { icon: "fa-brands fa-whatsapp",     bg: "#25d366" },
        x:         { icon: "fa-brands fa-x-twitter",    bg: "#000000" },
        snapchat:  { icon: "fa-brands fa-snapchat",     bg: "#f7d800", fg: "#111" },
        discord:   { icon: "fa-brands fa-discord",      bg: "#5865f2" },
        threads:   { icon: "fa-brands fa-threads",      bg: "#000000" },
        pinterest: { icon: "fa-brands fa-pinterest-p",  bg: "#e60023" },
        reddit:    { icon: "fa-brands fa-reddit-alien", bg: "#ff4500" },
        telegram:  { icon: "fa-brands fa-telegram",     bg: "#229ed9" }
    };
    var footerSocials = (typeof site !== "undefined" && site.socials) ? site.socials : [];
    var mailto = "mailto:" + ((typeof site !== "undefined" && site.email) ? site.email : "support@mizantrade.com");
    var siteName = (typeof site !== "undefined" && site.siteName) ? site.siteName : "Mizan Trade";
%>
<footer class="site-footer">
    <div class="sf-wrap">

        <div class="sf-grid">

            <!-- Logo + editable info blocks + shipping charges -->
            <div class="sf-col sf-info">

                <% if (fLogo.image) { %>
                    <% if (fLogo.link) { %><a href="<%= fLogo.link %>" class="sf-logo-link"><% } %>
                        <img
                            src="<%= optimizeImage(fLogo.image, 400) %>"
                            alt="<%= siteName %>"
                            class="sf-logo"
                            style="--sf-logo-h: <%= fLogo.height %>px; --sf-logo-mh: <%= fLogo.mobileHeight %>px;"
                        >
                    <% if (fLogo.link) { %></a><% } %>
                <% } %>

                <% fInfo.forEach(function (b) { %>
                    <div class="sf-info-block">
                        <% if (b.title) { %>
                            <h4 class="sf-info-title"><%= b.title %></h4>
                        <% } %>

                        <% if (b.kind === "image" && b.image) { %>
                            <% if (b.link) { %><a href="<%= b.link %>"><% } %>
                                <img src="<%= optimizeImage(b.image, 800) %>" alt="<%= b.title || 'Footer image' %>" class="sf-info-img" loading="lazy">
                            <% if (b.link) { %></a><% } %>
                        <% } %>

                        <% if (b.kind === "video" && b.video) { %>
                            <%
                                var videoSrc = b.video;
                                var ytMatch = b.video.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{6,})/i);
                                var vimeoMatch = b.video.match(/vimeo\.com\/(\d+)/i);
                                var isVideoFile = /\.(mp4|webm|ogg)(\?|#|$)/i.test(b.video);
                                if (ytMatch) videoSrc = "https://www.youtube.com/embed/" + ytMatch[1];
                                else if (vimeoMatch) videoSrc = "https://player.vimeo.com/video/" + vimeoMatch[1];
                            %>
                            <% if (isVideoFile) { %>
                                <video class="sf-info-video" src="<%= b.video %>" controls playsinline preload="metadata"></video>
                            <% } else { %>
                                <div class="sf-info-video">
                                    <iframe src="<%= videoSrc %>" title="<%= b.title || 'Footer video' %>" loading="lazy" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                                </div>
                            <% } %>
                        <% } %>

                        <% if (b.text) { %>
                            <% if (b.link) { %>
                                <a href="<%= b.link %>" class="sf-info-text"><%= b.text %></a>
                            <% } else { %>
                                <p class="sf-info-text"><%= b.text %></p>
                            <% } %>
                        <% } %>
                    </div>
                <% }); %>

            </div>

            <!-- Editable link columns -->
            <% fCols.forEach(function (col) { %>
                <div class="sf-col">
                    <% if (col.title) { %>
                        <h4 class="sf-title"><%= col.title %></h4>
                    <% } %>
                    <ul class="sf-links">
                        <% col.links.forEach(function (l) { %>
                            <li>
                                <a href="<%= l.url || '#' %>">
                                    <%= l.label || l.url %>
                                </a>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            <% }); %>

            <!-- Dynamic CMS pages (admin-controlled via showInFooter) -->
            <% if (typeof footerPages !== "undefined" && footerPages && footerPages.length) { %>
                <div class="sf-col">
                    <h4 class="sf-title">More</h4>
                    <ul class="sf-links">
                        <% footerPages.forEach(function (fp) { %>
                            <li><a href="/page/<%= fp.slug %>"><%= fp.title %></a></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <!-- Legacy admin-managed footer blocks from Settings -->
            <% if (typeof site !== "undefined" && site.footerBlocks && site.footerBlocks.length) { %>
                <% site.footerBlocks.forEach(function (block) { if (!block.items || !block.items.length) return; %>
                    <div class="sf-col">
                        <% if (block.title) { %>
                            <h4 class="sf-title"><%= block.title %></h4>
                        <% } %>
                        <ul class="sf-links sf-blocks">
                            <% block.items.forEach(function (it) { %>
                                <% if (it.type === "link") { %>
                                    <li>
                                        <a href="<%= it.url || '#' %>" class="sf-link-icon">
                                            <% if (it.image) { %><img src="<%= optimizeImage(it.image, 64) %>" alt="<%= it.text || 'link' %>" class="sf-inline-img"><% } %>
                                            <%= it.text %>
                                        </a>
                                    </li>
                                <% } else if (it.type === "image") { %>
                                    <li class="sf-block-media">
                                        <% if (it.url) { %><a href="<%= it.url %>" target="_blank" rel="noopener"><% } %>
                                            <img src="<%= optimizeImage(it.image, 800) %>" alt="<%= it.text || 'image' %>" class="sf-block-img" loading="lazy">
                                        <% if (it.url) { %></a><% } %>
                                    </li>
                                <% } else if (it.type === "video") { %>
                                    <li class="sf-block-media">
                                        <%
                                            var vurl = String(it.url || "");
                                            var ytMatch = vurl.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([\w-]{6,})/);
                                        %>
                                        <% if (ytMatch) { %>
                                            <iframe class="sf-video" src="https://www.youtube.com/embed/<%= ytMatch[1] %>" title="<%= it.text || 'Video' %>" loading="lazy" allowfullscreen></iframe>
                                        <% } else if (vurl) { %>
                                            <a href="<%= vurl %>" target="_blank" rel="noopener" class="sf-link-icon"><i class="fa-solid fa-video"></i><%= it.text || "Watch video" %></a>
                                        <% } %>
                                    </li>
                                <% } else { %>
                                    <li class="sf-text-item"><%= it.text %></li>
                                <% } %>
                            <% }); %>
                        </ul>
                    </div>
                <% }); %>
            <% } %>

            <!-- Membership logos + social links -->
            <div class="sf-col sf-connect">
                <% if (fMemb.length) { %>
                    <h4 class="sf-title"><%= fMembTitle %></h4>
                    <div class="sf-members">
                        <% fMemb.forEach(function (m) { %>
                            <% if (m.link) { %><a href="<%= m.link %>" target="_blank" rel="noopener" class="sf-member"><% } else { %><span class="sf-member"><% } %>
                                <% if (m.image) { %>
                                    <img src="<%= optimizeImage(m.image, 240) %>" alt="<%= m.name || 'Membership' %>" style="height: <%= m.height || 34 %>px;" loading="lazy">
                                <% } else { %>
                                    <span class="sf-member-text"><%= m.name %></span>
                                <% } %>
                            <% if (m.link) { %></a><% } else { %></span><% } %>
                        <% }); %>
                    </div>
                <% } %>

                <h4 class="sf-title sf-follow-title">Follow Us</h4>
                <div class="sf-socials">
                    <% footerSocials.forEach(function (s) { if (!s.url) return; var m = socialMap[s.platform]; if (!m) return; %>
                        <a href="<%= s.url %>" target="_blank" rel="noopener" title="<%= s.label || s.platform %>" style="background: <%= m.bg %>; <%= m.fg ? 'color:' + m.fg : '' %>;">
                            <i class="<%= m.icon %>"></i>
                        </a>
                    <% }); %>
                    <a href="<%= mailto %>" class="sf-social-mail" title="Email us"><i class="fas fa-envelope"></i></a>
                </div>
            </div>

        </div>

        <div class="sf-bottom">
            <div class="sf-copy">
                <%= fCopy || ((typeof site !== "undefined" && site.footerText) ? site.footerText : "© " + new Date().getFullYear() + " " + siteName + " | All Rights Reserved.") %>
            </div>

            <% if (fIcons.length) { %>
                <div class="sf-payments">
                    <% fIcons.forEach(function (p) { %>
                        <% if (p.image) { %>
                            <span class="sf-pay"><img src="<%= optimizeImage(p.image, 160) %>" alt="<%= p.name || 'Payment method' %>" loading="lazy"></span>
                        <% } else if (p.name) { %>
                            <span class="sf-pay sf-pay-text"><%= p.name %></span>
                        <% } %>
                    <% }); %>
                </div>
            <% } %>
        </div>

    </div>
</footer>
<%
    var footerMarketing = (typeof site !== "undefined" && site.marketing) ? site.marketing : {};
%>
<% if (footerMarketing.gtmId) { %>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= footerMarketing.gtmId %>" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
<% } %>
<% if (footerMarketing.customBody) { %>
    <%- footerMarketing.customBody %>
<% } %>
<%- include("chatWidget") %>
