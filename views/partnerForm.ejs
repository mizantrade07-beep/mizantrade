<!DOCTYPE html>
<html lang="bn">
<head>
    <link rel="icon" href="/images/logo.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Become a Partner - Mizan Trade</title>
</head>
<body>

    <%- include('partials/header') %>

    <div class="container" style="max-width:760px;">

        <div class="breadcrumb">
            <a href="/">Home</a>
            <i class="fa-solid fa-angle-right" style="margin:0 6px; font-size:10px;"></i>
            <span>Become a Partner</span>
        </div>

        <div class="content-card" style="padding:34px;">

            <div style="text-align:center; margin-bottom:26px;">
                <h1 style="color:#081621; font-size:24px; margin-bottom:10px;">
                    <i class="fa-solid fa-handshake" style="color:#ef4a23;"></i> Join Mizan Trade B2B Network
                </h1>
                <p style="color:#777; font-size:13.5px; line-height:1.7; max-width:560px; margin:0 auto;">
                    If you run a dealer/retail business in computer components, join us.
                    Fill out the form and submit your company documents — we will verify them and get back to you.
                </p>
            </div>

            <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                <div class="alert alert-success" style="text-align:center;">
                    <i class="fa-solid fa-circle-check"></i> <%= successMessage %>
                </div>
            <% } %>

            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <div class="alert alert-danger" style="text-align:center;">
                    <i class="fa-solid fa-circle-exclamation"></i> <%= errorMessage %>
                </div>
            <% } %>

            <form action="/become-a-partner" method="POST" enctype="multipart/form-data">

                <div class="form-grid">
                    <div class="form-group">
                        <label>Company / Shop Name <span class="req">*</span></label>
                        <input type="text" name="companyName" class="form-control" placeholder="e.g. Rahman Traders" value="<%= form.companyName || '' %>" required>
                    </div>

                    <div class="form-group">
                        <label>Owner / Proprietor Name <span class="req">*</span></label>
                        <input type="text" name="ownerName" class="form-control" placeholder="Your name" value="<%= form.ownerName || '' %>" required>
                    </div>

                    <div class="form-group">
                        <label>Email <span class="req">*</span></label>
                        <input type="email" name="email" class="form-control" placeholder="email@domain.com" value="<%= form.email || '' %>" required>
                    </div>

                    <div class="form-group">
                        <label>Mobile Number <span class="req">*</span></label>
                        <input type="tel" name="phone" class="form-control" placeholder="01XXXXXXXXX" value="<%= form.phone || '' %>" pattern="01[0-9]{9}" required>
                    </div>

                    <div class="form-group">
                        <label>Trade License Number</label>
                        <input type="text" name="tradeLicense" class="form-control" placeholder="Trade license number" value="<%= form.tradeLicense || '' %>">
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <input type="text" name="address" class="form-control" placeholder="Shop/office address" value="<%= form.address || '' %>">
                    </div>

                    <div class="form-group full">
                        <label>Business Details <span class="req">*</span></label>
                        <textarea name="businessDetails" class="form-control" rows="4"
                                  placeholder="Tell us about your business — what kind of products you sell, years of experience, estimated monthly sales, etc..." required><%= form.businessDetails || '' %></textarea>
                    </div>

                    <div class="form-group full" style="margin-top:6px;">
                        <label style="font-size:15px; color:#081621;">
                            <i class="fa-solid fa-folder-open" style="color:#ef4a23;"></i>
                            Documents &amp; Verification
                        </label>
                        <small style="color:#888; font-size:12px; display:block; margin-top:2px;">
                            Upload clear scans or photos. You can select multiple files in each field
                            (PDF, JPG, PNG or WEBP, up to 10MB each). Only admins can see these documents.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>Visiting Card <span class="req">*</span></label>
                        <input type="file" name="visitingCard" class="form-control" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" style="padding:9px;" required>
                        <small style="color:#999; font-size:11.5px;">Front and back, up to 3 files.</small>
                    </div>

                    <div class="form-group">
                        <label>Trade License <span class="req">*</span></label>
                        <input type="file" name="tradeLicenseDoc" class="form-control" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" style="padding:9px;" required>
                        <small style="color:#999; font-size:11.5px;">Valid license copy, up to 3 files.</small>
                    </div>

                    <div class="form-group">
                        <label>BIN Certificate</label>
                        <input type="file" name="binDoc" class="form-control" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" style="padding:9px;">
                        <small style="color:#999; font-size:11.5px;">Up to 3 files.</small>
                    </div>

                    <div class="form-group">
                        <label>TIN Certificate</label>
                        <input type="file" name="tinDoc" class="form-control" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" style="padding:9px;">
                        <small style="color:#999; font-size:11.5px;">Up to 3 files.</small>
                    </div>

                    <div class="form-group">
                        <label>NID / Passport</label>
                        <input type="file" name="nidDoc" class="form-control" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" style="padding:9px;">
                        <small style="color:#999; font-size:11.5px;">Owner's ID, up to 3 files.</small>
                    </div>

                    <div class="form-group">
                        <label>Owner Photo</label>
                        <input type="file" name="ownerPhoto" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp" style="padding:9px;">
                        <small style="color:#999; font-size:11.5px;">Up to 2 photos.</small>
                    </div>

                    <div class="form-group full">
                        <label>Other Documents</label>
                        <input type="file" name="otherDocs" class="form-control" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" style="padding:9px;">
                        <small style="color:#999; font-size:11.5px;">Bank statement, VAT certificate, shop photo, etc. Up to 10 files.</small>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%; padding:14px; font-size:15px;">
                    <i class="fa-solid fa-paper-plane"></i> Submit Partner Request
                </button>

            </form>

        </div>

    </div>

    <%- include('partials/footer') %>

    <script src="/js/main.js?v=4"></script>
</body>
</html>
