<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/seo') %>
</head>
<body>

    <%- include('partials/header') %>

    <div class="container">

        <!-- ==================== ১+২. হিরো স্লাইডার + সাইড কার্ড ==================== -->
        <% if (heroSlides.length || heroSideCards.length) { %>
        <div class="hero-wrap<%= !heroSideCards.length ? ' hero-wrap-solo' : '' %><%= !heroSlides.length ? ' hero-wrap-no-slider' : '' %>"
             <%= heroSlides.length && heroSideCards.length && heroSideWidth ? 'style="grid-template-columns:1fr ' + heroSideWidth + 'px;"' : '' %>>

            <% if (heroSlides.length) { %>
            <div class="hero-slider">
                <% heroSlides.forEach(function (slide, i) { %>
                    <%
                        var slideOverlay = (slide.overlay === undefined || slide.overlay === null) ? 75 : Number(slide.overlay);
                        if (!isFinite(slideOverlay)) slideOverlay = 75;
                        slideOverlay = Math.min(100, Math.max(0, slideOverlay)) / 100;
                        var slideBg = slide.image ? String(optimizeImage(slide.image, 1920)).replace(/'/g, "%27").replace(/"/g, "%22") : "";
                    %>
                    <div class="hero-slide hero-slide-<%= (i % 3) + 1 %><%= slide.image ? ' hero-slide--photo' : '' %> <%= i === 0 ? 'active' : '' %>"
                         <% if (slide.image) { %>
                         style="background-image: linear-gradient(rgba(8,22,33,<%= slideOverlay %>), rgba(8,22,33,<%= slideOverlay %>)), url('<%= slideBg %>'); <%= slide.height ? 'min-height:' + slide.height + 'px;' : '' %>"
                         <% } else if (slide.height) { %>
                         style="min-height:<%= slide.height %>px;"
                         <% } %>>
                        <% if (slide.tag) { %><span class="hero-tag"><%= slide.tag %></span><% } %>
                        <% if (slide.title) { %><h1><%= slide.title %></h1><% } %>
                        <% if (slide.text) { %><p><%= slide.text %></p><% } %>
                        <% if (slide.buttonText) { %>
                            <div>
                                <a href="<%= slide.buttonLink || '/shop' %>" class="btn btn-primary hero-cta">
                                    <i class="fa-solid fa-arrow-right"></i> <%= slide.buttonText %>
                                </a>
                            </div>
                        <% } %>
                    </div>
                <% }); %>

                <% if (heroSlides.length > 1) { %>
                    <div class="hero-dots">
                        <% heroSlides.forEach(function (slide, i) { %>
                            <button class="hero-dot <%= i === 0 ? 'active' : '' %>" aria-label="Slide <%= i + 1 %>"></button>
                        <% }); %>
                    </div>
                <% } %>
            </div>
            <% } %>

            <% if (heroSideCards.length) { %>
            <div class="hero-side">
                <% heroSideCards.forEach(function (card, i) { %>
                    <%
                        var cardStyle = "";
                        if (card.image) {
                            var bgUrl = String(optimizeImage(card.image, 700)).replace(/'/g, "%27").replace(/"/g, "%22");
                            var cardOverlay = (card.overlay === undefined || card.overlay === null) ? 62 : Number(card.overlay);
                            if (!isFinite(cardOverlay)) cardOverlay = 62;
                            cardOverlay = Math.min(100, Math.max(0, cardOverlay)) / 100;
                            cardStyle += "background-image:linear-gradient(rgba(8,22,33," + cardOverlay + "),rgba(8,22,33," + cardOverlay + ")),url('" + bgUrl + "');";
                            if (card.bgColor) cardStyle += "background-color:" + card.bgColor + ";";
                        } else if (card.bgColor) {
                            cardStyle += "background:" + card.bgColor + ";";
                        }
                        if (card.height) {
                            cardStyle += "--card-h:" + Number(card.height) + "px;";
                        }
                    %>
                    <div class="hero-side-card hero-side-card-<%= (i % 2) + 1 %><%= card.image ? ' has-bg' : '' %><%= card.height ? ' hero-side-card--sized' : '' %>"
                         <% if (cardStyle) { %>style="<%= cardStyle %>"<% } %>>
                        <% if (card.icon || card.title) { %>
                            <h3>
                                <% if (card.icon) { %><i class="<%= card.icon %>" style="color:#ef4a23;"></i> <% } %>
                                <% if (card.title) { %><%= card.title %><% } %>
                            </h3>
                        <% } %>
                        <% if (card.text) { %><p><%= card.text %></p><% } %>
                        <% if (card.link && card.linkText) { %>
                            <a href="<%= card.link %>" class="side-link">
                                <%= card.linkText %> <i class="fa-solid fa-angle-right"></i>
                            </a>
                        <% } %>
                    </div>
                <% }); %>
            </div>
            <% } %>

        </div>
        <% } %>

        <!-- ==================== ইমেজ: after-hero ==================== -->
        <% (imagesBySlot['after-hero'] || []).forEach(function (im) { %>
            <%- include('partials/imageBanner', { im: im }) %>
        <% }); %>

        <!-- ==================== ৩. Why choose us? ==================== -->
        <% if (whyItems.length) { %>
            <section class="why-section">
                <% if (whyTitle || whySubtitle || whyDescription) { %>
                <div class="why-head">
                    <% if (whyTitle) { %><h2><%= whyTitle %></h2><% } %>
                    <% if (whySubtitle) { %><p><%= whySubtitle %></p><% } %>
                    <% if (whyDescription) { %><p class="why-desc"><%= whyDescription %></p><% } %>
                </div>
                <% } %>
                <div class="why-grid">
                    <% whyItems.forEach(function (item) { %>
                        <% if (item.link) { %><a href="<%= item.link %>" class="why-card why-card-link"><% } else { %><div class="why-card"><% } %>
                            <% if (item.icon) { %><i class="<%= item.icon %>"></i><% } %>
                            <% if (item.title || item.text) { %>
                            <div>
                                <% if (item.title) { %><h3><%= item.title %></h3><% } %>
                                <% if (item.text) { %><p><%= item.text %></p><% } %>
                            </div>
                            <% } %>
                        <% if (item.link) { %></a><% } else { %></div><% } %>
                    <% }); %>
                </div>
            </section>
        <% } %>

        <!-- ==================== ৪. Featured Category ==================== -->
        <% if (featuredCats.length) { %>
            <section class="featured-cats">
                <% if (featTitle || featSubtitle || featDescription) { %>
                <div class="why-head">
                    <% if (featTitle) { %><h2><%= featTitle %></h2><% } %>
                    <% if (featSubtitle) { %><p><%= featSubtitle %></p><% } %>
                    <% if (featDescription) { %><p class="why-desc"><%= featDescription %></p><% } %>
                </div>
                <% } %>
                <div class="fc-grid">
                    <% featuredCats.forEach(function (cat) { %>
                        <a href="/category/<%= cat.slug %>" class="fc-card">
                            <% if (cat.icon) { %><i class="<%= cat.icon %>"></i><% } %>
                            <span><%= cat.name %></span>
                        </a>
                    <% }); %>
                </div>
            </section>
        <% } %>

        <!-- ==================== ইমেজ: after-featured ==================== -->
        <% (imagesBySlot['after-featured'] || []).forEach(function (im) { %>
            <%- include('partials/imageBanner', { im: im }) %>
        <% }); %>

        <!-- ==================== ৫–১১. প্রোডাক্ট সেকশন + ইমেজ (Homepage Content CMS) ==================== -->
        <% (productBlocks || []).forEach(function (block, idx) { %>
            <%- include('partials/productSection', { section: block }) %>
            <% (imagesAfterBlock[idx] || []).forEach(function (im) { %>
                <%- include('partials/imageBanner', { im: im }) %>
            <% }); %>
        <% }); %>

        <!-- কোনো নির্দিষ্ট kind-এর সেকশন না থাকলে সেই স্লটের ব্যানার এখানে -->
        <% (imagesAfterProducts || []).forEach(function (im) { %>
            <%- include('partials/imageBanner', { im: im }) %>
        <% }); %>

        <!-- ==================== ১২. Brand Section ==================== -->
        <% if (brandLogos.length) { %>
            <% if (brandSectionTitle) { %>
            <div class="section">
                <div class="section-header">
                    <h2><i class="fa-solid fa-tags"></i> <%= brandSectionTitle %></h2>
                </div>
            </div>
            <% } %>
            <div class="brand-strip">
                <% brandLogos.forEach(function (b) { %>
                    <%- b.link ? '<a href="' + b.link + '" style="display:inline-flex; align-items:center;">' : '<span>' %>
                        <% if (b.image) { %>
                            <img src="<%= optimizeImage(b.image, 260) %>" alt="<%= b.name || 'Brand' %>" loading="lazy" decoding="async">
                        <% } else { %>
                            <%= b.name %>
                        <% } %>
                    <%- b.link ? '</a>' : '</span>' %>
                <% }); %>
            </div>
        <% } %>

        <!-- ==================== ইমেজ: before-footer ==================== -->
        <% (imagesBySlot['before-footer'] || []).forEach(function (im) { %>
            <%- include('partials/imageBanner', { im: im }) %>
        <% }); %>

    </div>

    <%- include('partials/footer') %>

    <script src="/js/main.js?v=4"></script>
</body>
</html>
