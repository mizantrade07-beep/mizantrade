<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="/images/logo.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings - Mizan Trade</title>
    <style>
        .settings-shell { max-width: 900px; margin: 0 auto; }
        .settings-head {
            display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
            background: #fff; border: 1px solid #eef0f3; border-radius: 14px;
            padding: 20px 22px; margin: 18px 0; box-shadow: 0 6px 18px rgba(8,22,33,.05);
        }
        .settings-ic {
            width: 52px; height: 52px; border-radius: 14px; flex-shrink: 0;
            background: #fff3ef; color: #ef4a23; font-size: 22px;
            display: flex; align-items: center; justify-content: center;
        }
        .settings-head h1 { margin: 0; font-size: 19px; font-weight: 700; color: #081621; }
        .settings-head p { margin: 4px 0 0; font-size: 13px; color: #77808c; }
        .settings-back {
            margin-left: auto; display: inline-flex; align-items: center; gap: 7px;
            padding: 9px 14px; border: 1.5px solid #e3e8ef; border-radius: 9px;
            color: #374957; font-size: 13px; font-weight: 700; text-decoration: none; transition: .15s;
        }
        .settings-back:hover { border-color: #ef4a23; color: #ef4a23; background: #fff7f4; }
        .settings-section {
            color: #081621; margin: 0 0 16px; font-size: 16px;
            padding-bottom: 10px; border-bottom: 1px solid #f0f2f5;
            scroll-margin-top: 90px;
        }
        .settings-section i { color: #ef4a23; }
        .settings-section-sub { margin: 26px 0 16px; font-size: 15px; scroll-margin-top: 90px; }
        .settings-note { margin: 6px 0 0; font-size: 12.5px; color: #8892a0; }
        @media (max-width: 560px) {
            .settings-back { margin-left: 0; }
        }
    </style>
</head>
<body>

    <%- include('../partials/header') %>

    <div class="container">

        <div class="breadcrumb">
            <a href="/">Home</a>
            <i class="fa-solid fa-angle-right" style="margin:0 6px; font-size:10px;"></i>
            <a href="/account">My Account</a>
            <i class="fa-solid fa-angle-right" style="margin:0 6px; font-size:10px;"></i>
            <span>Account Settings</span>
        </div>

        <div class="settings-shell">

            <div class="settings-head">
                <div class="settings-ic"><i class="fa-solid fa-user-gear"></i></div>
                <div>
                    <h1>Account Settings</h1>
                    <p>Manage your profile details and password</p>
                </div>
                <a href="/account" class="settings-back">
                    <i class="fa-solid fa-arrow-left"></i> Back to My Account
                </a>
            </div>

            <% if (typeof updated !== 'undefined' && updated) { %>
                <div style="background:#e8f6ee; color:#1e7d43; padding:12px 16px; border-radius:8px; margin:0 0 16px; border:1px solid #bfe6cd; font-size:14px;">
                    <i class="fa-solid fa-circle-check"></i> Profile updated successfully.
                </div>
            <% } %>

            <div class="content-card" style="margin-bottom:30px;">
                <form action="/account/update" method="POST">

                    <h3 class="settings-section" id="profile">
                        <i class="fa-solid fa-id-card"></i> Profile Information
                    </h3>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" name="name" class="form-control" value="<%= profile.name %>">
                        </div>

                        <div class="form-group">
                            <label>Mobile</label>
                            <input type="tel" name="phone" class="form-control" value="<%= profile.phone || '' %>">
                        </div>

                        <div class="form-group">
                            <label>Gender</label>
                            <select name="gender" class="form-control">
                                <option value="">Select</option>
                                <option value="male" <%= profile.gender === 'male' ? 'selected' : '' %>>Male</option>
                                <option value="female" <%= profile.gender === 'female' ? 'selected' : '' %>>Female</option>
                                <option value="other" <%= profile.gender === 'other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Date of Birth</label>
                            <input type="date" name="dateOfBirth" class="form-control"
                                   value="<%= profile.dateOfBirth ? new Date(profile.dateOfBirth).toISOString().slice(0,10) : '' %>">
                        </div>

                        <div class="form-group full">
                            <label>Address</label>
                            <textarea name="address" class="form-control" style="min-height:60px;"><%= profile.address || '' %></textarea>
                        </div>

                        <div class="form-group">
                            <label>City</label>
                            <input type="text" name="city" class="form-control" value="<%= profile.city || '' %>">
                        </div>

                        <div class="form-group">
                            <label>District</label>
                            <input type="text" name="district" class="form-control" value="<%= profile.district || '' %>">
                        </div>

                        <div class="form-group">
                            <label>Postal Code</label>
                            <input type="text" name="postalCode" class="form-control" value="<%= profile.postalCode || '' %>">
                        </div>
                    </div>

                    <h3 class="settings-section settings-section-sub" id="password">
                        <i class="fa-solid fa-key"></i> Change Password (optional)
                    </h3>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Current Password</label>
                            <input type="password" name="currentPassword" class="form-control" placeholder="Required only if you already have a password">
                        </div>
                        <div class="form-group">
                            <label>New Password</label>
                            <input type="password" name="newPassword" class="form-control" placeholder="At least 6 characters">
                        </div>
                    </div>
                    <p class="settings-note">
                        Leave both password fields empty to keep your current password.
                        Social or OTP accounts can set a first password without entering the current one.
                    </p>

                    <button type="submit" class="btn btn-primary" style="margin-top:18px;">
                        <i class="fa-solid fa-floppy-disk"></i> Save Changes
                    </button>
                </form>
            </div>

        </div>
    </div>

    <%- include('../partials/footer') %>

    <script src="/js/main.js?v=4"></script>
</body>
</html>
