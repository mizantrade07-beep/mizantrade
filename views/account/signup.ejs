<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="/images/logo.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account - Mizan Trade</title>
    <%- include('authStyles') %>
</head>
<body>

    <%- include('../partials/header') %>

    <%
        var formData = (typeof form !== 'undefined' && form) ? form : {};
        var socialReady = (typeof oauthConfigured === 'function') && (
            oauthConfigured('google') || oauthConfigured('facebook') || oauthConfigured('tiktok')
        );
    %>

    <div class="container auth-wrap">

        <div class="auth-card">

            <div class="auth-hero">
                <div class="ah-ic"><i class="fa-solid fa-user-plus"></i></div>
                <h1>Create Your Account</h1>
                <p>Verify your phone to open an account<% if (socialReady) { %>, or continue with a social account<% } %></p>
            </div>

            <div class="auth-body">

                <% if (typeof message !== 'undefined' && message) { %>
                    <div class="auth-banner err"><i class="fa-solid fa-circle-exclamation"></i> <%= message %></div>
                <% } %>

                <form action="/signup" method="POST">

                    <div class="auth-grid">
                        <div class="auth-field">
                            <label>First Name <span style="color:#c0392b;">*</span></label>
                            <input type="text" name="firstName" class="auth-input" placeholder="e.g. Rahim"
                                   value="<%= formData.firstName || '' %>" required>
                        </div>
                        <div class="auth-field">
                            <label>Last Name <span style="color:#c0392b;">*</span></label>
                            <input type="text" name="lastName" class="auth-input" placeholder="e.g. Uddin"
                                   value="<%= formData.lastName || '' %>" required>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label>E-Mail <span style="color:#c0392b;">*</span></label>
                        <input type="email" name="email" class="auth-input" placeholder="you@example.com"
                               value="<%= formData.email || '' %>" required>
                    </div>

                    <div class="auth-field">
                        <label>Cell Phone <span style="color:#c0392b;">*</span></label>
                        <input type="tel" name="phone" class="auth-input" placeholder="01XXXXXXXXX"
                               value="<%= formData.phone || '' %>" required>
                    </div>

                    <label class="auth-check">
                        <input type="checkbox" name="privacy" <%= formData.privacy ? 'checked' : '' %> required>
                        <span>I have read and agree to the <a href="/page/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a> <span style="color:#c0392b;">*</span></span>
                    </label>

                    <button type="submit" class="auth-btn">
                        <i class="fa-solid fa-arrow-right"></i> Continue
                    </button>

                </form>

                <p class="auth-hint">
                    <i class="fa-solid fa-circle-info" style="color:#ef4a23;"></i>
                    A 6-digit code will be sent by SMS to your phone. You will set your password on the next step.
                </p>

                <%- include('socialAuth', { socialDividerText: 'or sign up with' }) %>

                <p class="auth-note">
                    If you already have an account,
                    <a href="/login" class="auth-link">Log In</a>
                </p>

            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script src="/js/main.js?v=4"></script>
</body>
</html>
