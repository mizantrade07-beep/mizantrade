<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Login - Mizan Trade</title>
    <link rel="icon" href="/images/logo.svg">
</head>
<body>

    <%- include('../partials/header') %>

    <div class="container" style="max-width:460px;">

        <div class="content-card" style="padding:40px 28px; margin-top:26px;">

            <div style="text-align:center; margin-bottom:22px;">
                <div style="width:72px; height:72px; border-radius:50%; background:#f4f6f9; display:inline-flex; align-items:center; justify-content:center; margin-bottom:14px;">
                    <i class="fa-regular fa-user" style="font-size:30px; color:#374957;"></i>
                </div>
                <h1 style="color:#081621; font-size:21px; margin:0;">Customer Login</h1>
                <p style="color:#777; font-size:14px; margin-top:8px;">
                    Sign in to your account
                </p>
            </div>

            <% if (message) { %>
                <div style="background:#fdecea; color:#c0392b; padding:12px 16px; border-radius:8px; margin-bottom:18px; border:1px solid #f5c6cb; font-size:14px;">
                    <i class="fa-solid fa-circle-exclamation"></i> <%= message %>
                </div>
            <% } %>

            <form action="/login" method="POST">

                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" class="form-control" placeholder="Your password" required>
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%; margin-top:8px;">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i> Log In
                </button>

            </form>

            <p style="text-align:center; margin-top:20px; font-size:14px; color:#666;">
                Don't have an account? <a href="/signup" style="color:#ef4a23; font-weight:600;">Register</a>
            </p>

        </div>

    </div>

    <%- include('../partials/footer') %>

    <script src="/js/main.js?v=2"></script>
</body>
</html>
