<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="/images/logo.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Login - Mizan Trade</title>
    <%- include('authStyles') %>
</head>
<body>

    <%- include('../partials/header') %>

    <%
        var noticeText = (typeof notice !== 'undefined' && notice) ? notice : '';
        var errorText = (typeof message !== 'undefined' && message) ? message : '';
        var socialReady = (typeof oauthConfigured === 'function') && (
            oauthConfigured('google') || oauthConfigured('facebook') || oauthConfigured('tiktok')
        );
    %>

    <div class="container auth-wrap">

        <div class="auth-card">

            <div class="auth-hero">
                <div class="ah-ic"><i class="fa-solid fa-lock"></i></div>
                <h1>Account Login</h1>
                <p>Phone / E-mail and password<%= socialReady ? ', or a social account' : '' %></p>
            </div>

            <div class="auth-body">

                <% if (errorText) { %>
                    <div class="auth-banner err"><i class="fa-solid fa-circle-exclamation"></i> <%= errorText %></div>
                <% } %>
                <% if (noticeText) { %>
                    <div class="auth-banner ok"><i class="fa-solid fa-circle-check"></i> <%= noticeText %></div>
                <% } %>

                <!-- ===== EMAIL / PHONE + PASSWORD ===== -->
                <form action="/login" method="POST">
                    <div class="auth-field">
                        <label>Email or Mobile Number</label>
                        <input type="text" name="identifier" class="auth-input" placeholder="you@example.com or 01XXXXXXXXX" required>
                    </div>
                    <div class="auth-field">
                        <label>Password</label>
                        <div class="pw-wrap">
                            <input type="password" name="password" id="loginPassword" class="auth-input" placeholder="Your password" required>
                            <button type="button" class="pw-toggle" data-target="loginPassword"><i class="fa-regular fa-eye"></i></button>
                        </div>
                    </div>
                    <div class="auth-row">
                        <span></span>
                        <a href="/forgot-password" class="auth-link">Forgotten Password?</a>
                    </div>
                    <button type="submit" class="auth-btn">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i> Log In
                    </button>
                </form>

                <%- include('socialAuth', { socialDividerText: 'or continue with' }) %>

                <a href="/signup" class="auth-create">
                    <i class="fa-solid fa-user-plus"></i> Don't have an account? Create Your Account
                </a>

            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script>
        (function () {
            document.querySelectorAll('.pw-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(btn.getAttribute('data-target'));
                    if (!input) return;
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.innerHTML = show ? '<i class="fa-regular fa-eye-slash"></i>' : '<i class="fa-regular fa-eye"></i>';
                });
            });
        })();
    </script>
    <script src="/js/main.js?v=4"></script>
</body>
</html>
