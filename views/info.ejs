<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/seo') %>
    <link rel="icon" href="/images/logo.svg">
</head>
<body>

    <%- include('partials/header') %>

    <div class="container" style="max-width:900px;">

        <div class="breadcrumb">
            <a href="/">Home</a>
            <i class="fa-solid fa-angle-right" style="margin:0 6px; font-size:10px;"></i>
            <span><%= page.title %></span>
        </div>

        <div class="content-card" style="padding:34px;">
            <h1 class="page-title" style="margin-top:0;"><%= page.title %></h1>
            <div style="font-size:14px; line-height:1.9; color:#444;">
                <%- page.content %>
            </div>
        </div>

    </div>

    <%- include('partials/footer') %>

    <script src="/js/main.js?v=2"></script>
</body>
</html>
