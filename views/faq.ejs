<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/seo') %>
    <style>
        .faq-wrap { max-width: 1200px; margin: 0 auto; padding: 0 15px 30px; }

        /* Search bar */
        .faq-search-box { display: flex; gap: 10px; margin: 10px 0 24px; }
        .faq-search-box input {
            flex: 1; padding: 14px 18px; border: 2px solid #e5e5e5; border-radius: 6px;
            font-size: 14px; outline: none; font-family: inherit; min-width: 0;
        }
        .faq-search-box input:focus { border-color: #ef4a23; }
        .faq-search-box button {
            background: #ef4a23; color: #fff; border: none; padding: 14px 30px;
            border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; white-space: nowrap;
        }
        .faq-search-box button:hover { background: #d63d18; }

        .faq-layout { display: flex; gap: 24px; align-items: flex-start; }

        /* Category sidebar */
        .faq-categories {
            flex: 0 0 280px; background: #fff; border: 1px solid #e5e5e5; border-radius: 8px;
            padding: 16px; position: sticky; top: 12px;
        }
        .faq-categories h3 { font-size: 15px; color: #081621; margin-bottom: 12px; }
        .faq-cat-item {
            display: flex; align-items: center; gap: 10px; width: 100%; text-align: left;
            padding: 11px 12px; border: none; background: none; border-radius: 6px;
            font-size: 13.5px; color: #374957; cursor: pointer; font-family: inherit;
            transition: background 0.15s;
        }
        .faq-cat-item:hover { background: #f4f6f9; }
        .faq-cat-item.active { background: #ef4a23; color: #fff; }
        .faq-cat-item .cat-ico { width: 22px; text-align: center; flex: 0 0 22px; }
        .faq-cat-item .cat-count {
            margin-left: auto; background: rgba(0,0,0,0.08); border-radius: 12px;
            font-size: 11px; padding: 2px 8px; font-weight: 600;
        }
        .faq-cat-item.active .cat-count { background: rgba(255,255,255,0.25); }

        /* Questions column */
        .faq-panel { flex: 1; min-width: 0; background: #fff; border: 1px solid #e5e5e5; border-radius: 8px; padding: 22px; }
        .faq-panel h2 { font-size: 18px; color: #081621; margin-bottom: 4px; }
        .faq-panel .faq-panel-sub { font-size: 13px; color: #777; margin-bottom: 16px; }
        .faq-item { border: 1px solid #eee; border-radius: 6px; margin-bottom: 10px; overflow: hidden; }
        .faq-q {
            display: flex; align-items: center; gap: 12px; width: 100%; text-align: left;
            padding: 14px 16px; background: #fff; border: none; cursor: pointer;
            font-size: 14px; font-weight: 600; color: #081621; font-family: inherit;
        }
        .faq-q:hover { background: #fafbfc; }
        .faq-q .faq-num {
            flex: 0 0 26px; height: 26px; border-radius: 50%; background: #f4f6f9;
            color: #374957; font-size: 12px; display: inline-flex; align-items: center;
            justify-content: center; font-weight: 700;
        }
        .faq-q .faq-chevron { margin-left: auto; color: #999; font-size: 12px; transition: transform 0.2s; }
        .faq-item.open .faq-chevron { transform: rotate(180deg); }
        .faq-a { display: none; padding: 0 16px 16px 54px; font-size: 13.5px; line-height: 1.8; color: #555; }
        .faq-item.open .faq-a { display: block; }
        .faq-a img, .faq-a video { max-width: 100% !important; height: auto !important; }
        .faq-empty { padding: 40px 20px; text-align: center; color: #888; font-size: 14px; }

        /* Support card */
        .faq-support {
            margin-top: 24px; background: #fff; border: 1px solid #e5e5e5; border-left: 4px solid #ef4a23;
            border-radius: 8px; padding: 22px; display: flex; gap: 20px; align-items: center; flex-wrap: wrap;
        }
        .faq-support .sup-ico {
            width: 54px; height: 54px; border-radius: 50%; background: #f4f6f9;
            display: inline-flex; align-items: center; justify-content: center; flex: 0 0 54px;
        }
        .faq-support .sup-ico i { font-size: 24px; color: #ef4a23; }
        .faq-support .sup-body { flex: 1; min-width: 220px; }
        .faq-support h3 { font-size: 16px; color: #081621; margin-bottom: 6px; }
        .faq-support p { font-size: 13px; color: #777; line-height: 1.7; margin: 0; }
        .faq-support .sup-actions { display: flex; flex-direction: column; gap: 8px; }
        .faq-support .sup-actions a {
            display: inline-flex; align-items: center; justify-content: center; gap: 8px;
            padding: 10px 18px; border-radius: 6px; font-size: 13px; font-weight: 600;
            text-decoration: none; white-space: nowrap;
        }
        .sup-call { background: #82b440; color: #fff; }
        .sup-call:hover { background: #719d37; }
        .sup-mail { background: #fff; color: #374957; border: 1px solid #ddd; }
        .sup-mail:hover { border-color: #999; }
        .sup-partner { background: #081621; color: #fff; }
        .sup-partner:hover { background: #0f2433; }

        @media(max-width: 860px) {
            .faq-layout { flex-direction: column; }
            .faq-categories { position: static; flex: none; width: 100%; }
            .faq-a { padding-left: 16px; }
        }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <div class="container faq-wrap">

        <div class="breadcrumb" style="margin-top:15px;">
            <a href="/">Home</a>
            <i class="fa-solid fa-angle-right" style="margin:0 6px; font-size:10px;"></i>
            <span>FAQ</span>
        </div>

        <h1 class="page-title" style="margin-top:0;">Frequently Asked Questions</h1>

        <div class="faq-search-box">
            <input type="text" id="faqSearch" placeholder="Search your question..." autocomplete="off">
            <button type="button" onclick="document.getElementById('faqSearch').focus();">Search</button>
        </div>

        <% if (!groups.length) { %>
            <div class="faq-panel">
                <div class="faq-empty">No FAQs have been published yet. Please check back soon.</div>
            </div>
        <% } else { %>

        <div class="faq-layout">

            <!-- Category list -->
            <aside class="faq-categories">
                <h3><i class="fa-solid fa-list" style="margin-right:6px;"></i> Categories</h3>
                <% groups.forEach(function (g, gi) { %>
                    <button type="button" class="faq-cat-item <%= gi === 0 ? 'active' : '' %>" data-cat="<%= gi %>">
                        <span class="cat-ico"><i class="fa-solid <%= gi === 0 ? 'fa-house' : gi === 1 ? 'fa-handshake' : gi === 2 ? 'fa-tag' : gi === 3 ? 'fa-cart-shopping' : gi === 4 ? 'fa-credit-card' : gi === 5 ? 'fa-truck' : gi === 6 ? 'fa-shield-halved' : 'fa-headset' %>"></i></span>
                        <span><%= g.category %></span>
                        <span class="cat-count"><%= g.items.length %></span>
                    </button>
                <% }) %>
            </aside>

            <!-- Question panels (one per category) -->
            <div style="flex:1; min-width:0;">
                <% groups.forEach(function (g, gi) { %>
                    <div class="faq-panel faq-group" data-cat="<%= gi %>" <%- gi === 0 ? '' : 'style="display:none;"' %>>
                        <h2><%= g.category %></h2>
                        <div class="faq-panel-sub">Answers to common questions about <%= g.category.toLowerCase() %> at Mizan Trade</div>

                        <% g.items.forEach(function (f, fi) { %>
                            <div class="faq-item" data-text="<%= (f.question + ' ' + f.answer).toLowerCase().replace(/"/g, '&quot;') %>">
                                <button type="button" class="faq-q">
                                    <span class="faq-num"><%= fi + 1 %></span>
                                    <span><%= f.question %></span>
                                    <i class="fa-solid fa-chevron-down faq-chevron"></i>
                                </button>
                                <div class="faq-a"><%- f.answer %></div>
                            </div>
                        <% }) %>
                    </div>
                <% }) %>

                <!-- Support card -->
                <div class="faq-support">
                    <span class="sup-ico"><i class="fa-solid fa-headset"></i></span>
                    <div class="sup-body">
                        <h3>Still Have Questions?</h3>
                        <p>Couldn't find the answer you were looking for? Our team is ready to help you with product information, dealer pricing, bulk orders and other inquiries.</p>
                    </div>
                    <%
                        var rawHotline = (typeof site !== 'undefined' && site.hotline) ? String(site.hotline) : '01709867815';
                        var telHotline = rawHotline.replace(/\D/g, '');
                        var showHotline = rawHotline.charAt(0) === '+' ? rawHotline : '+' + rawHotline;
                    %>
                    <div class="sup-actions">
                        <a class="sup-call" href="tel:<%= telHotline %>">
                            <i class="fa-solid fa-phone"></i> <%= showHotline %>
                        </a>
                        <a class="sup-mail" href="mailto:<%= (typeof site !== 'undefined' && site.email) ? site.email : 'support@mizantrade.com' %>">
                            <i class="fa-solid fa-envelope"></i> <%= (typeof site !== 'undefined' && site.email) ? site.email : 'support@mizantrade.com' %>
                        </a>
                        <a class="sup-partner" href="/become-a-partner">
                            Become a Partner <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

        </div>
        <% } %>

    </div>

    <%- include('partials/footer') %>

    <script src="/js/main.js?v=4"></script>
    <script>
    (function () {
        var catButtons = document.querySelectorAll(".faq-cat-item");
        var panels = document.querySelectorAll(".faq-group");

        catButtons.forEach(function (btn) {
            btn.addEventListener("click", function () {
                var cat = btn.getAttribute("data-cat");
                catButtons.forEach(function (b) { b.classList.toggle("active", b === btn); });
                panels.forEach(function (p) {
                    p.style.display = p.getAttribute("data-cat") === cat ? "" : "none";
                });
            });
        });

        document.querySelectorAll(".faq-q").forEach(function (q) {
            q.addEventListener("click", function () {
                q.closest(".faq-item").classList.toggle("open");
            });
        });

        var search = document.getElementById("faqSearch");
        if (search) {
            search.addEventListener("input", function () {
                var term = search.value.trim().toLowerCase();
                var firstMatchPanel = null;

                panels.forEach(function (p) {
                    var anyVisible = false;
                    p.querySelectorAll(".faq-item").forEach(function (item) {
                        var hit = !term || item.getAttribute("data-text").indexOf(term) !== -1;
                        item.style.display = hit ? "" : "none";
                        if (hit) anyVisible = true;
                    });
                    p.style.display = anyVisible ? "" : "none";
                    if (anyVisible && !firstMatchPanel) firstMatchPanel = p;
                });

                if (firstMatchPanel) {
                    var cat = firstMatchPanel.getAttribute("data-cat");
                    catButtons.forEach(function (b) {
                        b.classList.toggle("active", b.getAttribute("data-cat") === cat);
                    });
                }
            });
        }
    })();
    </script>
</body>
</html>
