<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="/images/logo.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= docLabel %> - <%= order.orderNumber %> - Mizan Trade</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: Arial, Helvetica, sans-serif; color: #081621;
            font-size: 12.5px; background: #f2f4f7; padding: 18px;
        }
        .sheet {
            background: #fff; max-width: 820px; margin: 0 auto; padding: 34px 38px;
            box-shadow: 0 8px 28px rgba(8,22,33,.12); border-radius: 4px;
        }

        /* Company header */
        .doc-head { display: flex; justify-content: space-between; align-items: center; gap: 18px; }
        .doc-head img { height: 58px; width: auto; display: block; }
        .co { text-align: right; line-height: 1.65; }
        .co .co-line { color: #45566a; font-size: 12px; }
        .doc-rule { border: none; border-top: 3px solid #ef4a23; margin: 12px 0 18px; }

        .doc-title { text-align: center; margin-bottom: 16px; }
        .doc-title h1 {
            display: inline-block; font-size: 17px; letter-spacing: 3px; font-weight: 700;
            color: #081621; border: 2px solid #081621; padding: 7px 26px; text-transform: uppercase;
        }

        .meta-row { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 18px; flex-wrap: wrap; }
        .meta-box { line-height: 1.75; font-size: 12.5px; min-width: 240px; flex: 1; }
        .meta-box h3 { font-size: 11px; letter-spacing: 1.5px; color: #8892a0; text-transform: uppercase; margin-bottom: 4px; }
        .meta-box .strong { font-weight: 700; font-size: 14px; }
        .meta-right { text-align: right; }
        .badge {
            display: inline-block; border: 1px solid #cbd5e1; border-radius: 20px;
            padding: 2px 11px; font-size: 11px; font-weight: 700; color: #374957; background: #f8fafc;
        }

        table.items { width: 100%; border-collapse: collapse; margin-top: 4px; }
        table.items th {
            background: #081621; color: #fff; text-align: left; padding: 8px 10px;
            font-size: 11.5px; letter-spacing: .6px; text-transform: uppercase;
        }
        table.items td { padding: 8px 10px; border-bottom: 1px solid #e6eaf0; vertical-align: top; }
        table.items .num { text-align: right; white-space: nowrap; }
        table.items .ctr { text-align: center; }
        tfoot td { padding: 7px 10px; font-size: 12.5px; }
        .totals td:last-child { text-align: right; white-space: nowrap; }
        .grand td {
            border-top: 2px solid #081621; font-weight: 700; font-size: 14.5px; color: #ef4a23;
            padding-top: 9px;
        }
        .checkbox { display: inline-block; width: 13px; height: 13px; border: 1.6px solid #374957; }

        .sign-row { display: flex; justify-content: space-between; gap: 40px; margin-top: 46px; }
        .sign { flex: 1; text-align: center; }
        .sign .line { border-top: 1.5px solid #081621; margin-bottom: 6px; }
        .sign small { color: #45566a; font-size: 11.5px; }
        .doc-note { margin-top: 22px; padding: 10px 13px; background: #f8fafc; border: 1px solid #e6eaf0; border-radius: 6px; color: #45566a; font-size: 12px; line-height: 1.6; }

        .toolbar { max-width: 820px; margin: 0 auto 14px; display: flex; gap: 10px; }
        .btn {
            display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 9px;
            border: none; cursor: pointer; font-size: 13.5px; font-weight: 700; text-decoration: none;
            background: #ef4a23; color: #fff;
        }
        .btn.grey { background: #374957; }

        @media print {
            body { background: #fff; padding: 0; }
            .sheet { box-shadow: none; border-radius: 0; max-width: none; padding: 0; }
            .toolbar { display: none; }
            th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
        @page { size: A4; margin: 14mm; }
    </style>
</head>
<body>

    <div class="toolbar no-print">
        <button type="button" class="btn" onclick="window.print()">
            <i class="fa-solid fa-print"></i> Print
        </button>
        <a class="btn grey" href="/admin/order/<%= order._id %>">
            <i class="fa-solid fa-angle-left"></i> Back to Order
        </a>
    </div>

    <div class="sheet">

        <!-- Company header — content comes from admin-editable Site Settings -->
        <div class="doc-head">
            <img src="/images/mt-logo.png" alt="<%= settings.siteName %>">
            <div class="co">
                <% if (settings.address) { %><div class="co-line"><%= settings.address %></div><% } %>
                <% if (settings.hotline) { %><div class="co-line">Hotline: <%= settings.hotline %></div><% } %>
                <% if (settings.email) { %><div class="co-line"><%= settings.email %></div><% } %>
            </div>
        </div>
        <hr class="doc-rule">

        <div class="doc-title"><h1><%= docLabel %></h1></div>

        <div class="meta-row">
            <div class="meta-box">
                <% if (docKey === 'invoice') { %>
                    <h3>Bill / Ship To</h3>
                <% } else { %>
                    <h3>Deliver To</h3>
                <% } %>
                <div class="strong"><%= order.customer.name %></div>
                Mobile: <%= order.customer.phone %><br>
                <% if (order.customer.email) { %>Email: <%= order.customer.email %><br><% } %>
                Address: <%= order.customer.address %><br>
                <% if (order.customer.village) { %>Village/Area: <%= order.customer.village %><br><% } %>
                <% if (order.customer.thana) { %>Thana: <%= order.customer.thana %><br><% } %>
                <% if (order.customer.postOffice) { %>Post Office: <%= order.customer.postOffice %><br><% } %>
                <% if (order.customer.district) { %>District: <%= order.customer.district %><br><% } %>
                Area: <%= order.customer.city %>
            </div>
            <div class="meta-box meta-right">
                <h3>Document Info</h3>
                <div><span style="color:#8892a0;">No:</span> <span class="strong"><%= order.orderNumber %></span></div>
                <div><span style="color:#8892a0;">Date:</span> <%= new Date(order.createdAt).toLocaleDateString('en-GB') %></div>
                <div><span style="color:#8892a0;">Payment:</span> <%= ({ bkash: 'bKash', nagad: 'Nagad', rocket: 'Rocket', cod: 'Cash on Delivery', bank: 'Bank Transfer' })[order.paymentMethod] || order.paymentMethod %></div>
                <% if (order.paymentInfo && order.paymentInfo.trxId) { %>
                    <div><span style="color:#8892a0;">TrxID:</span> <%= order.paymentInfo.trxId %></div>
                <% } %>
                <div><span class="badge"><%= order.status %></span></div>
            </div>
        </div>

        <table class="items">
            <thead>
                <tr>
                    <th style="width:38px;">SL</th>
                    <th>Item Description</th>
                    <% if (docKey === 'invoice') { %><th class="num" style="width:110px;">Unit Price</th><% } %>
                    <th class="ctr" style="width:56px;">Qty</th>
                    <% if (docKey === 'invoice') { %><th class="num" style="width:110px;">Amount</th>
                    <% } else if (docKey === 'packing-challan') { %><th class="ctr" style="width:70px;">Packed</th><% } %>
                </tr>
            </thead>
            <tbody>
                <% order.items.forEach(function (item, i) { %>
                    <tr>
                        <td><%= i + 1 %></td>
                        <td><%= item.title %></td>
                        <% if (docKey === 'invoice') { %>
                            <td class="num">&#2547; <%= item.price.toLocaleString('en-US') %></td>
                        <% } %>
                        <td class="ctr"><%= item.quantity %></td>
                        <% if (docKey === 'invoice') { %>
                            <td class="num">&#2547; <%= (item.price * item.quantity).toLocaleString('en-US') %></td>
                        <% } else if (docKey === 'packing-challan') { %>
                            <td class="ctr"><span class="checkbox"></span></td>
                        <% } %>
                    </tr>
                <% }); %>
            </tbody>
            <% if (docKey === 'invoice') { %>
            <tfoot class="totals">
                <tr>
                    <td colspan="4" style="text-align:right; color:#8892a0;">Subtotal</td>
                    <td class="num">&#2547; <%= order.subtotal.toLocaleString('en-US') %></td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align:right; color:#8892a0;">Delivery Charge (<%= order.customer.city %>)</td>
                    <td class="num">&#2547; <%= order.shippingFee.toLocaleString('en-US') %></td>
                </tr>
                <% if (order.discount > 0) { %>
                <tr>
                    <td colspan="4" style="text-align:right; color:#1f8a3b;">Discount<% if (order.couponCode) { %> (<%= order.couponCode %>)<% } %></td>
                    <td class="num" style="color:#1f8a3b;">&#8722; &#2547; <%= order.discount.toLocaleString('en-US') %></td>
                </tr>
                <% } %>
                <% if (order.rewardPointsRedeemed > 0) { %>
                <tr>
                    <td colspan="4" style="text-align:right; color:#1f8a3b;">Reward Points (<%= order.rewardPointsRedeemed %> pts)</td>
                    <td class="num" style="color:#1f8a3b;">&#8722; &#2547; <%= Number(order.rewardDiscount || 0).toLocaleString('en-US', { maximumFractionDigits: 2 }) %></td>
                </tr>
                <% } %>
                <% if (order.taxAmount > 0) { %>
                <tr>
                    <td colspan="4" style="text-align:right; color:#374957;"><%= order.taxLabel || 'Tax' %><%= order.taxIncluded ? ' (included)' : '' %></td>
                    <td class="num" style="color:#374957;"><%= order.taxIncluded ? '' : '+' %> &#2547; <%= Number(order.taxAmount).toLocaleString('en-US', { maximumFractionDigits: 2 }) %></td>
                </tr>
                <% } %>
                <% if (order.paymentCharge > 0) { %>
                <tr>
                    <td colspan="4" style="text-align:right; color:#c0392b;">Payment Charge (bKash)</td>
                    <td class="num" style="color:#c0392b;">&#2547; <%= order.paymentCharge.toLocaleString('en-US', { maximumFractionDigits: 2 }) %></td>
                </tr>
                <% } %>
                <tr class="grand">
                    <td colspan="4" style="text-align:right;">Grand Total</td>
                    <td class="num">&#2547; <%= order.total.toLocaleString('en-US', { maximumFractionDigits: 2 }) %></td>
                </tr>
            </tfoot>
            <% } %>
        </table>

        <% if (docKey === 'delivery-challan' || docKey === 'delivery-slip') { %>
            <div class="doc-note">
                Received the above goods in good condition.
                <% if (docKey === 'delivery-slip') { %>
                    Please sign and return this delivery slip.
                <% } else { %>
                    This delivery challan is valid only with the authorized signature of <%= settings.siteName %>.
                <% } %>
            </div>
            <div class="sign-row">
                <div class="sign"><div class="line"></div><small>Receiver's Signature &amp; Date</small></div>
                <div class="sign"><div class="line"></div><small>For <%= settings.siteName %></small></div>
            </div>
        <% } else if (docKey === 'packing-challan') { %>
            <div class="doc-note">
                Total items: <strong><%= order.items.reduce(function (s, it) { return s + it.quantity; }, 0) %></strong> pc(s)
                in <strong><%= order.items.length %></strong> line(s). Tick each line after packing.
            </div>
            <div class="sign-row">
                <div class="sign"><div class="line"></div><small>Packed By</small></div>
                <div class="sign"><div class="line"></div><small>Checked By</small></div>
            </div>
        <% } else { %>
            <div class="doc-note">
                Thank you for shopping with <%= settings.siteName %>! This is a computer-generated invoice.
            </div>
            <div class="sign-row">
                <div class="sign"><div class="line"></div><small>Customer's Signature</small></div>
                <div class="sign"><div class="line"></div><small>For <%= settings.siteName %></small></div>
            </div>
        <% } %>

    </div>

</body>
</html>
