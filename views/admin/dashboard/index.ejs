<%- include("../partials/head") %>

<%- include("../partials/sidebar") %>

<div class="admin-main">

    <%- include("../partials/topbar") %>

    <main class="dashboard-content">

        <section class="dashboard-intro">

            <div>
                <p class="section-kicker">
                    OVERVIEW
                </p>

                <h2>
                    Welcome back, <%= admin?.name || "Admin" %>
                </h2>

                <p>
                    Manage your MizanTrade business from one place.
                </p>
            </div>

            <a
                href="/admin/products/add"
                class="primary-button"
            >
                + Add Product
            </a>

        </section>


        <!-- Statistics -->

        <section class="stats-grid">

            <article class="stat-card">

                <div class="stat-icon"><i class="fa-solid fa-box"></i></div>

                <div class="stat-content">

                    <span>
                        Total Products
                    </span>

                    <strong>
                        <%= stats.totalProducts %>
                    </strong>

                </div>

                <a href="/admin/products">
                    View products →
                </a>

            </article>


            <article class="stat-card">

                <div class="stat-icon"><i class="fa-solid fa-handshake"></i></div>

                <div class="stat-content">

                    <span>
                        Partner Applications
                    </span>

                    <strong>
                        <%= stats.totalPartners %>
                    </strong>

                </div>

                <a href="/admin/partners">
                    View applications →
                </a>

            </article>


            <article class="stat-card">

                <div class="stat-icon warning"><i class="fa-solid fa-hourglass-half"></i></div>

                <div class="stat-content">

                    <span>
                        Pending Partners
                    </span>

                    <strong>
                        <%= stats.pendingPartners %>
                    </strong>

                </div>

                <a href="/admin/partners">
                    Review applications →
                </a>

            </article>


            <article class="stat-card">

                <div class="stat-icon"><i class="fa-solid fa-cart-shopping"></i></div>

                <div class="stat-content">

                    <span>
                        Total Orders
                    </span>

                    <strong>
                        <%= stats.totalOrders || 0 %>
                    </strong>

                </div>

                <a href="/admin/orders">
                    View orders →
                </a>

            </article>


            <article class="stat-card">

                <div class="stat-icon warning"><i class="fa-solid fa-truck-fast"></i></div>

                <div class="stat-content">

                    <span>
                        Pending Orders
                    </span>

                    <strong>
                        <%= stats.pendingOrders || 0 %>
                    </strong>

                </div>

                <a href="/admin/orders?status=Pending">
                    Process orders →
                </a>

            </article>


            <article class="stat-card">

                <div class="stat-icon"><i class="fa-solid fa-user-shield"></i></div>

                <div class="stat-content">

                    <span>
                        Admin Accounts
                    </span>

                    <strong>
                        <%= stats.totalAdmins %>
                    </strong>

                </div>

                <span class="stat-note">
                    System access
                </span>

            </article>

        </section>


        <!-- Main dashboard grid -->

        <section class="dashboard-grid">

            <div class="dashboard-panel">

                <div class="panel-header">

                    <div>
                        <p class="panel-kicker">
                            PARTNERS
                        </p>

                        <h3>
                            Recent Applications
                        </h3>
                    </div>

                    <a href="/admin/partners">
                        View all
                    </a>

                </div>


                <% if (recentPartners.length === 0) { %>

                    <div class="empty-state">

                        <div class="empty-icon"><i class="fa-solid fa-inbox"></i></div>

                        <h4>
                            No partner applications yet
                        </h4>

                        <p>
                            New partner applications will appear here.
                        </p>

                    </div>

                <% } else { %>

                    <div class="table-wrapper">

                        <table class="admin-table">

                            <thead>

                                <tr>
                                    <th>Company</th>
                                    <th>Owner</th>
                                    <th>Phone</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>

                            </thead>

                            <tbody>

                                <% recentPartners.forEach((partner) => { %>

                                    <tr>

                                        <td>
                                            <strong>
                                                <%= partner.companyName %>
                                            </strong>
                                        </td>

                                        <td>
                                            <%= partner.ownerName %>
                                        </td>

                                        <td>
                                            <%= partner.phone %>
                                        </td>

                                        <td>

                                            <span
                                                class="status-badge
                                                <%= partner.status === 'Approved'
                                                    ? 'success'
                                                    : partner.status === 'Rejected'
                                                        ? 'danger'
                                                        : 'pending'
                                                %>"
                                            >
                                                <%= partner.status %>
                                            </span>

                                        </td>

                                        <td>
                                            <%= new Date(partner.createdAt)
                                                .toLocaleDateString("en-GB") %>
                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                <% } %>

            </div>


            <!-- Quick actions -->

            <aside class="dashboard-panel quick-panel">

                <div class="panel-header">

                    <div>

                        <p class="panel-kicker">
                            QUICK ACTIONS
                        </p>

                        <h3>
                            Manage Store
                        </h3>

                    </div>

                </div>


                <div class="quick-actions">

                    <a
                        href="/admin/products/add"
                        class="quick-action"
                    >
                        <span class="quick-icon"><i class="fa-solid fa-plus"></i></span>

                        <span>
                            <strong>
                                Add Product
                            </strong>

                            <small>
                                Add a new hardware product
                            </small>
                        </span>

                        <b>→</b>
                    </a>


                    <a
                        href="/admin/products"
                        class="quick-action"
                    >
                        <span class="quick-icon"><i class="fa-solid fa-boxes-stacked"></i></span>

                        <span>
                            <strong>
                                Manage Products
                            </strong>

                            <small>
                                Edit product catalog
                            </small>
                        </span>

                        <b>→</b>
                    </a>


                    <a
                        href="/admin/partners"
                        class="quick-action"
                    >
                        <span class="quick-icon"><i class="fa-solid fa-user-group"></i></span>

                        <span>
                            <strong>
                                Partner Applications
                            </strong>

                            <small>
                                Review business applications
                            </small>
                        </span>

                        <b>→</b>
                    </a>


                    <a
                        href="/"
                        target="_blank"
                        rel="noopener"
                        class="quick-action"
                    >
                        <span class="quick-icon"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>

                        <span>
                            <strong>
                                View Website
                            </strong>

                            <small>
                                Open the customer website
                            </small>
                        </span>

                        <b>→</b>
                    </a>

                </div>

            </aside>

        </section>


        <!-- System summary -->

        <section class="dashboard-panel system-panel">

            <div class="panel-header">

                <div>

                    <p class="panel-kicker">
                        SYSTEM
                    </p>

                    <h3>
                        Store Summary
                    </h3>

                </div>

            </div>

            <div class="summary-grid">

                <div class="summary-item">
                    <span>Product Reviews</span>
                    <strong><%= stats.totalReviews %></strong>
                </div>

                <div class="summary-item">
                    <span>Product Catalog</span>
                    <strong>
                        <%= stats.totalProducts > 0
                            ? "Active"
                            : "Empty" %>
                    </strong>
                </div>

                <div class="summary-item">
                    <span>Partner Queue</span>
                    <strong>
                        <%= stats.pendingPartners > 0
                            ? "Needs Review"
                            : "Clear" %>
                    </strong>
                </div>

            </div>

        </section>

    </main>

</div>

<%- include("../partials/footer") %>