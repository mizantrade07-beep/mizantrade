<%
    const p = post || {};
    const seo = p.seo || {};
    const formAction = post ? "/admin/posts/edit/" + post._id : "/admin/posts/add";
    const canPublish = can('content.publish');
    const tagsValue = (p.tags || []).join(', ');
%>

<%- include("partials/head", {
    title: (post ? "Edit Post" : "Add Post") + " | MizanTrade Admin"
}) %>

<%- include("partials/sidebar") %>

<div class="admin-main">

    <%- include("partials/topbar", {
        title: post ? "Edit Post" : "Add Post"
    }) %>

    <main class="admin-content">

        <div class="dashboard-header">
            <div>
                <h1 class="dashboard-title"><%= post ? "Edit Post" : "Add New Post" %></h1>
                <p class="dashboard-subtitle">Add blog article content, cover image, tags and SEO.</p>
            </div>

            <a href="/admin/posts" class="secondary-button">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Posts
            </a>
        </div>

        <form action="<%= formAction %>" method="POST" enctype="multipart/form-data" id="postForm">

            <div class="cms-two-col">

                <div class="side-stack">

                    <section class="dashboard-card">
                        <div class="card-header">
                            <h2 class="card-title"><i class="fa-solid fa-newspaper card-icon"></i> Post Content</h2>
                        </div>

                        <div class="form-grid">
                            <div class="form-group form-full">
                                <label for="titleInput">Post Title *</label>
                                <input type="text" id="titleInput" name="title" required
                                       value="<%= p.title || '' %>" placeholder="Example: Best budget gaming PC build of 2026">
                            </div>

                            <div class="form-group form-full">
                                <label for="slugInput">Slug <span class="label-hint">— leave blank to auto-generate</span></label>
                                <div class="input-with-btn">
                                    <input type="text" id="slugInput" name="slug" value="<%= p.slug || '' %>" placeholder="best-budget-gaming-pc">
                                    <label class="mini-check" title="Auto slug">
                                        <input type="checkbox" id="slugAuto" <%= post ? '' : 'checked' %>>
                                        Auto
                                    </label>
                                </div>
                                <div class="tag-input-hint">URL: <code>/blog/<span id="slugPreview"><%= p.slug || '...' %></span></code></div>
                            </div>

                            <div class="form-group form-full">
                                <label for="excerptInput">Excerpt / Short description</label>
                                <textarea id="excerptInput" name="excerpt" rows="2"
                                          placeholder="Short description shown in the blog list"><%= p.excerpt || '' %></textarea>
                            </div>

                            <div class="form-group form-full">
                                <label>Content</label>
                                <div class="rte-wrap">
                                    <div class="rte-toolbar" data-editor="contentEditor">
                                        <button type="button" class="rte-btn" data-cmd="bold" title="Bold"><i class="fa-solid fa-bold"></i></button>
                                        <button type="button" class="rte-btn" data-cmd="italic" title="Italic"><i class="fa-solid fa-italic"></i></button>
                                        <button type="button" class="rte-btn" data-cmd="underline" title="Underline"><i class="fa-solid fa-underline"></i></button>
                                        <span class="rte-sep"></span>
                                        <select class="rte-select" data-block title="Paragraph style">
                                            <option value="p">Paragraph</option>
                                            <option value="h2">Heading 2</option>
                                            <option value="h3">Heading 3</option>
                                            <option value="h4">Heading 4</option>
                                        </select>
                                        <span class="rte-sep"></span>
                                        <button type="button" class="rte-btn" data-cmd="insertUnorderedList" title="Bullet list"><i class="fa-solid fa-list-ul"></i></button>
                                        <button type="button" class="rte-btn" data-cmd="insertOrderedList" title="Numbered list"><i class="fa-solid fa-list-ol"></i></button>
                                        <span class="rte-sep"></span>
                                        <button type="button" class="rte-btn" data-cmd="createLink" title="Insert link"><i class="fa-solid fa-link"></i></button>
                                        <button type="button" class="rte-btn" data-cmd="unlink" title="Remove link"><i class="fa-solid fa-link-slash"></i></button>
                                        <span class="rte-sep"></span>
                                        <button type="button" class="rte-btn" data-role="image" title="Upload image"><i class="fa-solid fa-image"></i></button>
                                        <span class="rte-sep"></span>
                                        <button type="button" class="rte-btn" data-cmd="removeFormat" title="Clear formatting"><i class="fa-solid fa-eraser"></i></button>
                                    </div>
                                    <div class="rte-area tall" id="contentEditor" contenteditable="true"></div>
                                </div>
                                <textarea name="content" class="hidden-source" data-rte-source="contentEditor"><%= p.content || '' %></textarea>
                            </div>
                        </div>
                    </section>

                    <section class="dashboard-card">
                        <div class="card-header">
                            <h2 class="card-title"><i class="fa-solid fa-magnifying-glass card-icon"></i> SEO Settings</h2>
                        </div>
                        <div class="form-grid">
                            <div class="form-group form-full">
                                <label>Meta Title</label>
                                <input type="text" name="metaTitle" value="<%= seo.metaTitle || '' %>" placeholder="Google title">
                            </div>
                            <div class="form-group form-full">
                                <label>Meta Description</label>
                                <textarea name="metaDescription" rows="2" placeholder="150-160 character description"><%= seo.metaDescription || '' %></textarea>
                            </div>
                            <div class="form-group form-full">
                                <label>Keywords</label>
                                <input type="text" name="keywords" value="<%= seo.keywords || '' %>" placeholder="gaming pc, build guide">
                            </div>
                        </div>
                    </section>

                </div>

                <div class="side-stack">

                    <section class="dashboard-card">
                        <div class="card-header">
                            <h2 class="card-title"><i class="fa-solid fa-sliders card-icon"></i> Publish Settings</h2>
                        </div>

                        <div class="form-group">
                            <label for="statusSelect">Status</label>
                            <select id="statusSelect" name="status">
                                <option value="draft" <%= p.status === 'draft' || !post ? 'selected' : '' %>>Draft</option>
                                <option value="published" <%= p.status === 'published' ? 'selected' : '' %>
                                    <%= canPublish ? '' : 'disabled' %>>Published</option>
                            </select>
                            <% if (!canPublish) { %>
                                <div class="tag-input-hint">Publishing requires the Admin or Editor role.</div>
                            <% } %>
                        </div>

                        <div class="form-group">
                            <label for="authorInput">Author</label>
                            <input type="text" id="authorInput" name="author" value="<%= p.author || 'Mizan Trade' %>">
                        </div>

                        <div class="form-group">
                            <label for="tagsInput">Tags</label>
                            <input type="text" id="tagsInput" name="tags" value="<%= tagsValue %>" placeholder="gaming, ssd, build">
                            <div class="tag-input-hint">Separate with commas.</div>
                        </div>

                        <label class="checkbox-row">
                            <input type="checkbox" name="allowComments" <%= (post && p.allowComments === false) ? '' : 'checked' %>>
                            <span>Allow comments</span>
                        </label>
                    </section>

                    <section class="dashboard-card">
                        <div class="card-header">
                            <h2 class="card-title"><i class="fa-solid fa-image card-icon"></i> Cover Image</h2>
                        </div>
                        <div class="form-group">
                            <input type="file" name="coverImage" id="coverImage" accept="image/jpeg,image/png,image/webp">
                            <div class="img-preview-box" id="coverPreviewBox" style="<%= p.coverImage ? 'display:block;' : '' %>">
                                <img id="coverPreview" src="<%= p.coverImage || '' %>" alt="preview">
                            </div>
                        </div>
                    </section>

                    <div class="form-actions">
                        <button type="submit" class="primary-button">
                            <i class="fa-solid fa-floppy-disk"></i>
                            <%= post ? "Update Post" : "Create Post" %>
                        </button>
                    </div>

                </div>

            </div>

        </form>

    </main>

</div>

<%- include("partials/footer") %>

<script src="/admin/js/rte.js"></script>
<script>
(function () {
    var title = document.getElementById("titleInput");
    var slug = document.getElementById("slugInput");
    var auto = document.getElementById("slugAuto");
    var preview = document.getElementById("slugPreview");

    function slugify(v) {
        return String(v || "").trim().toLowerCase()
            .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
    }
    function updatePreview() { if (preview) preview.textContent = slug.value || "..."; }

    if (title && slug) {
        title.addEventListener("input", function () {
            if (auto && auto.checked) { slug.value = slugify(title.value); updatePreview(); }
        });
        slug.addEventListener("input", function () { if (auto) auto.checked = false; updatePreview(); });
    }

    var ci = document.getElementById("coverImage");
    var box = document.getElementById("coverPreviewBox");
    var img = document.getElementById("coverPreview");
    if (ci && box && img) {
        ci.addEventListener("change", function () {
            if (ci.files && ci.files[0]) { img.src = URL.createObjectURL(ci.files[0]); box.style.display = "block"; }
        });
    }
})();
</script>
