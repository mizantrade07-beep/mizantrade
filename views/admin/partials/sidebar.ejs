<aside class="admin-sidebar" id="adminSidebar">

    <div class="sidebar-brand">
        <a href="/admin/dashboard">
            <span class="brand-mark">M</span>

            <span class="brand-text">
                MizanTrade
            </span>
        </a>
    </div>

    <div class="sidebar-section">
        <span class="sidebar-label">
            MAIN
        </span>

        <nav class="sidebar-nav">

            <a
                href="/admin/dashboard"
                class="sidebar-link <%= currentPath === '/admin/dashboard' ? 'active' : '' %>"
            >
                <span class="nav-icon"><i class="fa-solid fa-gauge-high"></i></span>
                <span>Dashboard</span>
            </a>

            <% if (can('analytics.view')) { %>
                <a
                    href="/admin/analytics"
                    class="sidebar-link"
                >
                    <span class="nav-icon"><i class="fa-solid fa-chart-line"></i></span>
                    <span>Analytics</span>
                </a>

                <a
                    href="/admin/speed"
                    class="sidebar-link <%= currentPath === '/admin/speed' ? 'active' : '' %>"
                >
                    <span class="nav-icon"><i class="fa-solid fa-bolt"></i></span>
                    <span>Speed &amp; Performance</span>
                </a>
            <% } %>

        </nav>
    </div>

    <div class="sidebar-section">

        <span class="sidebar-label">
            CATALOG
        </span>

        <nav class="sidebar-nav">

            <a
                href="/admin/products"
                class="sidebar-link"
            >
                <span class="nav-icon"><i class="fa-solid fa-box-open"></i></span>
                <span>Products</span>
            </a>

            <a
                href="/admin/products/add"
                class="sidebar-link"
            >
                <span class="nav-icon"><i class="fa-solid fa-circle-plus"></i></span>
                <span>Add Product</span>
            </a>

            <a
                href="/admin/categories"
                class="sidebar-link"
            >
                <span class="nav-icon"><i class="fa-solid fa-layer-group"></i></span>
                <span>Categories</span>
            </a>

            <a
                href="/admin/attributes"
                class="sidebar-link <%= currentPath === '/admin/attributes' ? 'active' : '' %>"
            >
                <span class="nav-icon"><i class="fa-solid fa-sliders"></i></span>
                <span>Filter Attributes</span>
            </a>

        </nav>
    </div>

    <% if (can('content.edit') || can('moderate')) { %>
        <div class="sidebar-section">

            <span class="sidebar-label">
                CONTENT
            </span>

            <nav class="sidebar-nav">

                <% if (can('content.edit')) { %>
                    <a
                        href="/admin/homepage"
                        class="sidebar-link <%= currentPath === '/admin/homepage' ? 'active' : '' %>"
                    >
                        <span class="nav-icon"><i class="fa-solid fa-house-laptop"></i></span>
                        <span>Homepage Content</span>
                    </a>

                    <a
                        href="/admin/pages"
                        class="sidebar-link"
                    >
                        <span class="nav-icon"><i class="fa-solid fa-file-lines"></i></span>
                        <span>Pages</span>
                    </a>

                    <a
                        href="/admin/posts"
                        class="sidebar-link"
                    >
                        <span class="nav-icon"><i class="fa-solid fa-newspaper"></i></span>
                        <span>Posts / Blog</span>
                    </a>

                    <a
                        href="/admin/faqs"
                        class="sidebar-link <%= currentPath === '/admin/faqs' ? 'active' : '' %>"
                    >
                        <span class="nav-icon"><i class="fa-solid fa-circle-question"></i></span>
                        <span>FAQ Manager</span>
                    </a>

                    <a
                        href="/admin/offers"
                        class="sidebar-link <%= currentPath === '/admin/offers' ? 'active' : '' %>"
                    >
                        <span class="nav-icon"><i class="fa-solid fa-tags"></i></span>
                        <span>Offers Manager</span>
                    </a>

                    <a
                        href="/admin/team"
                        class="sidebar-link <%= currentPath === '/admin/team' ? 'active' : '' %>"
                    >
                        <span class="nav-icon"><i class="fa-solid fa-users"></i></span>
                        <span>Team Members</span>
                    </a>
                <% } %>

                <% if (can('moderate')) { %>
                    <a
                        href="/admin/comments"
                        class="sidebar-link"
                    >
                        <span class="nav-icon"><i class="fa-solid fa-comments"></i></span>
                        <span>Comments</span>
                    </a>

                    <a
                        href="/admin/reviews"
                        class="sidebar-link"
                    >
                        <span class="nav-icon"><i class="fa-solid fa-star"></i></span>
                        <span>Product Reviews</span>
                    </a>

                    <a
                        href="/admin/questions"
                        class="sidebar-link"
                    >
                        <span class="nav-icon"><i class="fa-solid fa-circle-question"></i></span>
                        <span>Customer Questions</span>
                    </a>
                <% } %>

            </nav>
        </div>
    <% } %>

    <div class="sidebar-section">

        <span class="sidebar-label">
            BUSINESS
        </span>

        <nav class="sidebar-nav">

            <a
                href="/admin/partners"
                class="sidebar-link"
            >
                <span class="nav-icon"><i class="fa-solid fa-handshake"></i></span>
                <span>Partners</span>
            </a>

            <a
                href="/admin/orders"
                class="sidebar-link"
            >
                <span class="nav-icon"><i class="fa-solid fa-cart-shopping"></i></span>
                <span>Orders</span>
            </a>

            <% if (can('orders.view')) { %>
                <a
                    href="/admin/chats"
                    class="sidebar-link <%= currentPath === '/admin/chats' ? 'active' : '' %>"
                >
                    <span class="nav-icon"><i class="fa-solid fa-headset"></i></span>
                    <span>Live Chats</span>
                </a>
            <% } %>

            <% if (can('customers.view')) { %>
                <a
                    href="/admin/customers"
                    class="sidebar-link"
                >
                    <span class="nav-icon"><i class="fa-solid fa-users"></i></span>
                    <span>Customers</span>
                </a>
            <% } %>

            <% if (can('coupons.manage')) { %>
                <a
                    href="/admin/coupons"
                    class="sidebar-link"
                >
                    <span class="nav-icon"><i class="fa-solid fa-tags"></i></span>
                    <span>Coupons</span>
                </a>
            <% } %>

            <% if (can('orders.view')) { %>
                <a
                    href="/admin/order-history"
                    class="sidebar-link <%= currentPath === '/admin/order-history' ? 'active' : '' %>"
                >
                    <span class="nav-icon"><i class="fa-solid fa-clock-rotate-left"></i></span>
                    <span>Order History</span>
                </a>
            <% } %>

            <% if (can('analytics.view')) { %>
                <a
                    href="/admin/payment-history"
                    class="sidebar-link <%= currentPath === '/admin/payment-history' ? 'active' : '' %>"
                >
                    <span class="nav-icon"><i class="fa-solid fa-money-bill-transfer"></i></span>
                    <span>Payment History</span>
                </a>

                <a
                    href="/admin/rewards"
                    class="sidebar-link <%= currentPath === '/admin/rewards' ? 'active' : '' %>"
                >
                    <span class="nav-icon"><i class="fa-solid fa-gift"></i></span>
                    <span>Reward Points</span>
                </a>
            <% } %>

        </nav>
    </div>

    <% if (can('staff.manage')) { %>
        <div class="sidebar-section">

            <span class="sidebar-label">
                TEAM
            </span>

            <nav class="sidebar-nav">

                <a
                    href="/admin/staff"
                    class="sidebar-link"
                >
                    <span class="nav-icon"><i class="fa-solid fa-user-shield"></i></span>
                    <span>Staff / Roles</span>
                </a>

            </nav>
        </div>
    <% } %>

    <div class="sidebar-section">

        <span class="sidebar-label">
            WEBSITE
        </span>

        <nav class="sidebar-nav">

            <a
                href="/"
                target="_blank"
                rel="noopener"
                class="sidebar-link"
            >
                <span class="nav-icon"><i class="fa-solid fa-globe"></i></span>
                <span>View Website</span>
            </a>

            <% if (can('settings.manage')) { %>
            <a
                href="/admin/footer"
                class="sidebar-link <%= currentPath === '/admin/footer' ? 'active' : '' %>"
            >
                <span class="nav-icon"><i class="fa-solid fa-shoe-prints"></i></span>
                <span>Footer</span>
            </a>
            <a
                href="/admin/payment-methods"
                class="sidebar-link <%= currentPath === '/admin/payment-methods' ? 'active' : '' %>"
            >
                <span class="nav-icon"><i class="fa-solid fa-credit-card"></i></span>
                <span>Payment Methods</span>
            </a>
            <a
                href="/admin/settings"
                class="sidebar-link <%= currentPath === '/admin/settings' ? 'active' : '' %>"
            >
                <span class="nav-icon"><i class="fa-solid fa-gear"></i></span>
                <span>Settings</span>
            </a>
            <a
                href="/admin/seo"
                class="sidebar-link <%= currentPath === '/admin/seo' ? 'active' : '' %>"
            >
                <span class="nav-icon"><i class="fa-solid fa-magnifying-glass-chart"></i></span>
                <span>SEO &amp; Marketing</span>
            </a>
            <a
                href="/admin/top-header"
                class="sidebar-link <%= currentPath === '/admin/top-header' ? 'active' : '' %>"
            >
                <span class="nav-icon"><i class="fa-solid fa-bullhorn"></i></span>
                <span>Top Header Panel</span>
            </a>
            <% } %>

        </nav>
    </div>

</aside>