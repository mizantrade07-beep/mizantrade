<%
    const cp = coupon || {};
    const formAction = coupon ? "/admin/coupons/edit/" + coupon._id : "/admin/coupons/add";

    function toDateInput(d) {
        if (!d) return "";
        var dt = new Date(d);
        if (isNaN(dt.getTime())) return "";
        return dt.toISOString().slice(0, 10);
    }

    const selectedProducts = (cp.applicableProducts || []).map(String);
    const selectedCustomers = (cp.applicableCustomers || []).map(String);
%>

<%- include("partials/head", {
    title: (coupon ? "Edit Coupon" : "Add Coupon") + " | MizanTrade Admin"
}) %>

<%- include("partials/sidebar") %>

<div class="admin-main">

    <%- include("partials/topbar", {
        title: coupon ? "Edit Coupon" : "Add Coupon"
    }) %>

    <main class="admin-content">

        <div class="dashboard-header">
            <div>
                <h1 class="dashboard-title"><%= coupon ? "Edit Coupon" : "Add New Coupon" %></h1>
                <p class="dashboard-subtitle">
                    Set the discount, applicable products or customers, validity and usage limit.
                </p>
            </div>

            <a href="/admin/coupons" class="secondary-button">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Coupons
            </a>
        </div>

        <form action="<%= formAction %>" method="POST">

            <div class="cms-two-col">

                <!-- ===== বাম কলাম ===== -->
                <div class="side-stack">

                    <section class="dashboard-card">
                        <div class="card-header">
                            <h2 class="card-title"><i class="fa-solid fa-tag card-icon"></i> Coupon Details</h2>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label for="codeInput">Coupon Code *</label>
                                <input type="text" id="codeInput" name="code" required
                                       value="<%= cp.code || '' %>" placeholder="e.g. EID25"
                                       style="text-transform:uppercase;">
                                <div class="tag-input-hint">Will be saved in uppercase.</div>
                            </div>

                            <div class="form-group">
                                <label for="discountType">Discount Type *</label>
                                <select id="discountType" name="discountType">
                                    <option value="percent" <%= cp.discountType === 'percent' || !coupon ? 'selected' : '' %>>Percent (%)</option>
                                    <option value="fixed" <%= cp.discountType === 'fixed' ? 'selected' : '' %>>Fixed Amount (৳)</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="discountValue">Discount Value *</label>
                                <input type="number" id="discountValue" name="discountValue" min="0" step="1" required
                                       value="<%= cp.discountValue != null ? cp.discountValue : '' %>" placeholder="e.g. 10">
                            </div>

                            <div class="form-group">
                                <label for="maxDiscount">Max Discount (৳)</label>
                                <input type="number" id="maxDiscount" name="maxDiscount" min="0" step="1"
                                       value="<%= cp.maxDiscount || '' %>" placeholder="0 = no limit">
                                <div class="tag-input-hint">Applies to Percent type only.</div>
                            </div>

                            <div class="form-group form-full">
                                <label for="description">Description</label>
                                <input type="text" id="description" name="description"
                                       value="<%= cp.description || '' %>" placeholder="Internal note (shown in the admin panel)">
                            </div>
                        </div>
                    </section>

                    <section class="dashboard-card">
                        <div class="card-header">
                            <h2 class="card-title"><i class="fa-solid fa-bullseye card-icon"></i> Applies To</h2>
                        </div>

                        <div class="form-grid">
                            <div class="form-group form-full">
                                <label>
                                    Specific products
                                    <span class="label-hint">— leave empty to apply to all products</span>
                                </label>

                                <div class="chip-picker"
                                     data-field="applicableProducts"
                                     data-items='<%- JSON.stringify(products.map(function (p) {
                                         return { id: String(p._id), label: p.title + (p.sku ? " (" + p.sku + ")" : "") };
                                     })) %>'
                                     data-selected='<%- JSON.stringify(selectedProducts) %>'>
                                    <div class="chip-picker-search">
                                        <input type="text" class="chip-picker-input" placeholder="Search a product…" autocomplete="off">
                                        <datalist></datalist>
                                        <button type="button" class="chip-picker-add secondary-button">Add</button>
                                    </div>
                                    <div class="chip-picker-list"></div>
                                </div>

                                <div class="tag-input-hint">Type to search, click Add. Click × on a chip to remove it.</div>
                            </div>

                            <div class="form-group form-full">
                                <label>
                                    Specific customers
                                    <span class="label-hint">— leave empty so everyone (including guests) can use it</span>
                                </label>

                                <div class="chip-picker"
                                     data-field="applicableCustomers"
                                     data-items='<%- JSON.stringify(customers.map(function (cu) {
                                         return { id: String(cu._id), label: cu.name + " — " + cu.email };
                                     })) %>'
                                     data-selected='<%- JSON.stringify(selectedCustomers) %>'>
                                    <div class="chip-picker-search">
                                        <input type="text" class="chip-picker-input" placeholder="Search a customer…" autocomplete="off">
                                        <datalist></datalist>
                                        <button type="button" class="chip-picker-add secondary-button">Add</button>
                                    </div>
                                    <div class="chip-picker-list"></div>
                                </div>

                                <div class="tag-input-hint">If selected, only those customers (while logged in) can use the coupon.</div>
                            </div>
                        </div>
                    </section>

                </div>

                <!-- ===== ডান কলাম ===== -->
                <div class="side-stack">

                    <section class="dashboard-card">
                        <div class="card-header">
                            <h2 class="card-title"><i class="fa-solid fa-sliders card-icon"></i> Limits &amp; Validity</h2>
                        </div>

                        <div class="form-group">
                            <label for="minOrderAmount">Minimum Order Amount (৳)</label>
                            <input type="number" id="minOrderAmount" name="minOrderAmount" min="0" step="1"
                                   value="<%= cp.minOrderAmount || '' %>" placeholder="0 = no minimum">
                        </div>

                        <div class="form-group">
                            <label for="usageLimit">Usage Limit (total)</label>
                            <input type="number" id="usageLimit" name="usageLimit" min="0" step="1"
                                   value="<%= cp.usageLimit || '' %>" placeholder="0 = unlimited">
                            <div class="tag-input-hint">Used so far: <%= cp.usedCount || 0 %></div>
                        </div>

                        <div class="form-group">
                            <label for="startDate">Start Date</label>
                            <input type="date" id="startDate" name="startDate" value="<%= toDateInput(cp.startDate) %>">
                        </div>

                        <div class="form-group">
                            <label for="endDate">End Date</label>
                            <input type="date" id="endDate" name="endDate" value="<%= toDateInput(cp.endDate) %>">
                        </div>

                        <label class="checkbox-row">
                            <input type="checkbox" name="isActive" <%= (coupon && !cp.isActive) ? '' : 'checked' %>>
                            <span>Coupon is Active</span>
                        </label>
                    </section>

                    <div class="form-actions">
                        <button type="submit" class="primary-button">
                            <i class="fa-solid fa-floppy-disk"></i>
                            <%= coupon ? "Update Coupon" : "Create Coupon" %>
                        </button>
                    </div>

                </div>

            </div>

        </form>

    </main>

</div>

<style>
    .chip-picker-search { display: flex; gap: 8px; align-items: center; }
    .chip-picker-input { flex: 1; }
    .chip-picker-add { flex-shrink: 0; white-space: nowrap; }
    .chip-picker-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .chip-picker-list:empty { display: none; }
    .chip {
        display: inline-flex; align-items: center; gap: 8px;
        background: #eef2ff; border: 1px solid #c7d2fe; color: #3730a3;
        border-radius: 999px; padding: 5px 10px; font-size: 13px; max-width: 100%;
    }
    .chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 260px; }
    .chip button {
        background: none; border: none; color: #6366f1; cursor: pointer;
        font-size: 15px; line-height: 1; padding: 0 2px;
    }
    .chip button:hover { color: #dc2626; }
</style>

<script>
    (function () {
        document.querySelectorAll(".chip-picker").forEach(function (picker) {
            var field = picker.dataset.field;
            var items = JSON.parse(picker.dataset.items || "[]");
            var selected = JSON.parse(picker.dataset.selected || "[]");
            var byId = {};
            items.forEach(function (it) { byId[it.id] = it.label; });

            var input = picker.querySelector(".chip-picker-input");
            var addBtn = picker.querySelector(".chip-picker-add");
            var list = picker.querySelector(".chip-picker-list");
            var datalist = picker.querySelector("datalist");
            datalist.id = "dl-" + field;
            input.setAttribute("list", datalist.id);

            function renderDatalist() {
                datalist.innerHTML = "";
                items.forEach(function (it) {
                    if (selected.indexOf(it.id) === -1) {
                        var o = document.createElement("option");
                        o.value = it.label;
                        datalist.appendChild(o);
                    }
                });
            }

            function render() {
                list.innerHTML = "";
                selected.forEach(function (id) {
                    var chip = document.createElement("div");
                    chip.className = "chip";

                    var hidden = document.createElement("input");
                    hidden.type = "hidden";
                    hidden.name = field;
                    hidden.value = id;

                    var label = document.createElement("span");
                    label.textContent = byId[id] || id;

                    var rm = document.createElement("button");
                    rm.type = "button";
                    rm.innerHTML = "&times;";
                    rm.addEventListener("click", function () {
                        selected = selected.filter(function (s) { return s !== id; });
                        render();
                        renderDatalist();
                    });

                    chip.appendChild(hidden);
                    chip.appendChild(label);
                    chip.appendChild(rm);
                    list.appendChild(chip);
                });
            }

            function add() {
                var q = input.value.trim();
                if (!q) return;
                var match = items.find(function (it) {
                    return it.label.toLowerCase() === q.toLowerCase();
                });
                if (!match) {
                    match = items.find(function (it) {
                        return it.label.toLowerCase().indexOf(q.toLowerCase()) !== -1;
                    });
                }
                if (match && selected.indexOf(match.id) === -1) {
                    selected.push(match.id);
                    render();
                    renderDatalist();
                }
                input.value = "";
            }

            addBtn.addEventListener("click", add);
            input.addEventListener("keydown", function (e) {
                if (e.key === "Enter") { e.preventDefault(); add(); }
            });

            render();
            renderDatalist();
        });
    })();
</script>

<%- include("partials/footer") %>
