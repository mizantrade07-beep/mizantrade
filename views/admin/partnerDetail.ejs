<%- include("partials/head", {
    title: "Partner Application | MizanTrade Admin"
}) %>

<%- include("partials/sidebar") %>

<div class="admin-main">

    <%- include("partials/topbar", {
        title: "Partner Details"
    }) %>

    <main class="admin-content">

        <div class="dashboard-header">
            <div>
                <h1 class="dashboard-title"><%= partner.companyName %></h1>
                <p class="dashboard-subtitle">
                    Application date: <%= new Date(partner.createdAt).toLocaleString('en-GB') %>
                </p>
            </div>

            <a href="/admin/partners" class="secondary-button">← Back to Partners</a>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:18px; align-items:start;">

            <!-- আবেদনকারীর তথ্য -->
            <section class="dashboard-card">
                <div class="card-header">
                    <h2 class="card-title">Application Information</h2>
                </div>
                <div class="card-body" style="font-size:13.5px; line-height:2;">
                    <strong>Company:</strong> <%= partner.companyName %><br>
                    <strong>Owner:</strong> <%= partner.ownerName %><br>
                    <strong>Phone:</strong> <a href="tel:<%= partner.phone %>"><%= partner.phone %></a><br>
                    <strong>Email:</strong> <a href="mailto:<%= partner.email %>"><%= partner.email %></a><br>
                    <% if (partner.address) { %>
                        <strong>Address:</strong> <%= partner.address %><br>
                    <% } %>
                    <% if (partner.tradeLicense) { %>
                        <strong>Trade License:</strong> <%= partner.tradeLicense %><br>
                    <% } %>
                    <strong>Business Details:</strong><br>
                    <div style="background:#f8f9fb; border:1px solid #eee; border-radius:6px; padding:12px; margin-top:6px; white-space:pre-wrap;"><%= partner.businessDetails %></div>
                </div>
            </section>

            <!-- ডকুমেন্টস + স্ট্যাটাস -->
            <section class="dashboard-card">
                <div class="card-header">
                    <h2 class="card-title">Documents & Verification</h2>
                </div>
                <div class="card-body">

                    <% if (partner.documents && partner.documents.length > 0) { %>
                        <div style="margin-bottom:18px;">
                            <% partner.documents.forEach(function(doc, docIndex) {
                                const isPdf = /pdf/i.test(doc.mimeType || doc.originalName || '');
                                const bytes = Number(doc.size) || 0;
                                const size = bytes > 0
                                    ? (bytes < 1024
                                        ? bytes + ' B'
                                        : (bytes < 1048576
                                            ? Math.max(1, Math.round(bytes / 1024)) + ' KB'
                                            : (bytes / 1048576).toFixed(1) + ' MB'))
                                    : '';
                            %>
                                <div style="display:flex; flex-wrap:wrap; align-items:center; gap:10px 12px; padding:10px 0; border-bottom:1px solid #f0f0f0;">
                                    <span style="width:34px; height:34px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; background:<%= isPdf ? '#fdecea' : '#eaf1fb' %>; color:<%= isPdf ? '#c53030' : '#2b6cb0' %>; flex:0 0 auto;">
                                        <i class="fa-solid <%= isPdf ? 'fa-file-pdf' : 'fa-file-image' %>"></i>
                                    </span>
                                    <div style="flex:1 1 150px; min-width:0;">
                                        <div style="font-size:13px; font-weight:600; color:#22303f; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                            <%= doc.originalName || 'Document' %>
                                        </div>
                                        <div style="font-size:11.5px; color:#8a94a3;">
                                            <% if (doc.label) { %><%= doc.label %><% } else { %>Document<% } %>
                                            <% if (size) { %> · <%= size %><% } %>
                                        </div>
                                    </div>
                                    <div style="display:flex; flex-wrap:wrap; gap:8px;">
                                        <a href="/admin/partners/<%= partner._id %>/document/<%= docIndex %>" target="_blank" rel="noopener"
                                           class="secondary-button" style="padding:6px 10px; font-size:12px; white-space:nowrap;">
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i> Open
                                        </a>
                                        <a href="/admin/partners/<%= partner._id %>/document/<%= docIndex %>?download=1"
                                           class="secondary-button" style="padding:6px 10px; font-size:12px; white-space:nowrap;">
                                            <i class="fa-solid fa-download"></i> Download
                                        </a>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p style="color:#999; font-size:13px; margin-bottom:18px;">No documents uploaded.</p>
                    <% } %>

                    <hr style="margin:14px 0; border:none; border-top:1px solid #eee;">

                    <form method="POST" action="/admin/partners/<%= partner._id %>/status">
                        <div style="margin-bottom:12px;">
                            <label style="display:block; font-size:12.5px; font-weight:600; margin-bottom:6px;">Admin Note</label>
                            <textarea name="adminNote" rows="3"
                                      style="width:100%; padding:9px; border:1px solid #ddd; border-radius:6px; font-family:inherit;"
                                      placeholder="Verification note..."><%= partner.adminNote || '' %></textarea>
                        </div>

                        <div style="display:flex; flex-wrap:wrap; gap:10px;">
                            <button type="submit" name="status" value="Approved" class="primary-button"
                                    style="background:#2f855a;">
                                ✓ Approve
                            </button>
                            <button type="submit" name="status" value="Rejected" class="primary-button"
                                    style="background:#c53030;">
                                ✕ Reject
                            </button>
                            <button type="submit" name="status" value="Pending" class="secondary-button">
                                Mark Pending
                            </button>
                        </div>
                    </form>

                    <p style="margin-top:14px; font-size:12.5px;">
                        Current status:
                        <% if (partner.status === 'Approved') { %>
                            <span class="badge badge-approved">Approved</span>
                        <% } else if (partner.status === 'Rejected') { %>
                            <span class="badge badge-rejected">Rejected</span>
                        <% } else { %>
                            <span class="badge badge-pending">Pending</span>
                        <% } %>
                    </p>

                </div>
            </section>

        </div>

        <!-- পার্টনার লগইন ম্যানেজমেন্ট -->
        <section class="dashboard-card" style="margin-top:18px;">
            <div class="card-header">
                <h2 class="card-title">
                    <i class="fa-solid fa-handshake"></i>
                    Offers Portal Login
                </h2>
            </div>
            <div class="card-body">

                <% if (typeof loginNotice !== 'undefined' && loginNotice) { %>
                    <div style="background:#e8f6ee; color:#1e7d43; border:1px solid #bfe6cd; border-radius:8px; padding:12px 15px; margin-bottom:16px; font-size:13.5px; font-weight:600;">
                        <i class="fa-solid fa-circle-check"></i> <%= loginNotice %>
                    </div>
                <% } %>

                <% if (!login) { %>
                    <% if (partner.status === 'Approved') { %>
                        <p style="font-size:13.5px; color:#555; margin-bottom:12px;">
                            This application is approved. Create a login so the partner can access the
                            <a href="/offers" target="_blank" style="color:#ef4a23; font-weight:600;">offers portal</a>
                            with their business e-mail.
                        </p>
                        <form method="POST" action="/admin/partners/<%= partner._id %>/create-login" style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                            <input type="text" name="password" placeholder="Password (leave empty to auto-generate)"
                                   style="padding:9px 12px; border:1px solid #ddd; border-radius:6px; min-width:260px;">
                            <button type="submit" class="primary-button">
                                <i class="fa-solid fa-user-lock"></i> Create Login
                            </button>
                        </form>
                    <% } else { %>
                        <p style="font-size:13.5px; color:#888;">
                            A portal login can be created after this application is <strong>Approved</strong>.
                        </p>
                    <% } %>
                <% } else { %>
                    <div style="font-size:13.5px; line-height:2;">
                        <strong>E-Mail:</strong> <%= login.email %><br>
                        <strong>Status:</strong>
                        <% if (login.isActive) { %>
                            <span class="badge badge-approved">Active</span>
                        <% } else { %>
                            <span class="badge badge-rejected">Disabled</span>
                        <% } %>
                        <br>
                        <strong>Last Login:</strong>
                        <%= login.lastLoginAt ? new Date(login.lastLoginAt).toLocaleString('en-GB') : 'Never' %>
                    </div>

                    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:16px; align-items:center;">
                        <form method="POST" action="/admin/partners/<%= partner._id %>/toggle-login">
                            <% if (login.isActive) { %>
                                <button type="submit" class="secondary-button" style="color:#c53030; border-color:#f5c6cb;">
                                    <i class="fa-solid fa-ban"></i> Disable Login
                                </button>
                            <% } else { %>
                                <button type="submit" class="primary-button" style="background:#2f855a;">
                                    <i class="fa-solid fa-check"></i> Enable Login
                                </button>
                            <% } %>
                        </form>
                        <form method="POST" action="/admin/partners/<%= partner._id %>/reset-password" style="display:flex; gap:8px; align-items:center;">
                            <input type="text" name="password" placeholder="New password (empty = auto-generate)"
                                   style="padding:9px 12px; border:1px solid #ddd; border-radius:6px; min-width:230px;">
                            <button type="submit" class="secondary-button">
                                <i class="fa-solid fa-key"></i> Reset Password
                            </button>
                        </form>
                    </div>
                <% } %>

            </div>
        </section>

    </main>

</div>

<%- include("partials/footer") %>
