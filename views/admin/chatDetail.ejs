<%- include("partials/head", {
    title: "Live Chat | MizanTrade Admin"
}) %>

<%- include("partials/sidebar") %>

<div class="admin-main">

    <%- include("partials/topbar", {
        title: "Chat with " + convo.displayName
    }) %>

    <main class="admin-content">

        <div class="dashboard-header">
            <div>
                <h1 class="dashboard-title"><%= convo.displayName %></h1>
                <p class="dashboard-subtitle" id="chat-mode-line">
                    <% if (convo.mode === 'human') { %>
                        Mode: <strong style="color:#b45309;">Team</strong> — the bot is paused for this conversation.
                    <% } else { %>
                        Mode: <strong style="color:#1d6fa5;">Bot</strong> — the assistant is answering automatically. Your first reply will take over.
                    <% } %>
                </p>
            </div>

            <div style="display:flex; gap:10px;">
                <% if (can('orders.manage')) { %>
                    <form method="POST" action="/admin/chats/<%= convo._id %>/bot-mode" style="margin:0;">
                        <input type="hidden" name="mode" id="chat-mode-input"
                               value="<%= convo.mode === 'human' ? 'bot' : 'human' %>">
                        <button type="submit" class="secondary-button" id="chat-mode-btn">
                            <i class="fa-solid fa-robot"></i>
                            <span id="chat-mode-btn-text"><%= convo.mode === 'human' ? 'Resume Bot' : 'Pause Bot' %></span>
                        </button>
                    </form>
                <% } %>
                <a href="/admin/chats" class="secondary-button">
                    <i class="fa-solid fa-arrow-left"></i> Back to Chats
                </a>
                <% if (can('orders.manage')) { %>
                    <form method="POST" action="/admin/chats/<%= convo._id %>/delete" style="margin:0;"
                          onsubmit="return confirm('Delete this conversation and all its messages permanently?');">
                        <button type="submit" class="secondary-button" style="color:#b91c1c; border-color:#fecaca;">
                            <i class="fa-solid fa-trash"></i> Delete Chat
                        </button>
                    </form>
                <% } %>
            </div>
        </div>

        <section class="dashboard-card">

            <div class="card-header">
                <h2 class="card-title">
                    <i class="fa-solid fa-comments card-icon"></i>
                    Conversation
                </h2>
                <span style="font-size:12px; color:#94a3b8;" id="chat-status">Auto-refresh: on</span>
            </div>

            <div id="chat-thread"
                 style="display:flex; flex-direction:column; gap:10px; min-height:380px; max-height:65vh; overflow-y:auto; padding:6px 4px;">

                <% messages.forEach(function (m) { %>
                    <div style="align-self:<%= m.sender === 'admin' ? 'flex-end' : 'flex-start' %>; max-width:78%;
                                background:<%= m.sender === 'admin' ? '#e8f5ec' : (m.sender === 'bot' ? '#eef2f6' : '#fff4ef') %>;
                                border:1px solid #e8ecf1; border-radius:12px; padding:10px 14px;">
                        <div style="font-size:11px; font-weight:700; color:#64748b; margin-bottom:4px;">
                            <%= m.sender === 'admin' ? (m.senderName || 'Team') : (m.sender === 'bot' ? 'Assistant' : convo.displayName) %>
                            · <%= new Date(m.createdAt).toLocaleString('en-GB') %>
                        </div>
                        <div style="font-size:13.5px; color:#1f2937; white-space:pre-wrap;"><%= m.text %></div>
                    </div>
                <% }); %>

                <% if (messages.length === 0) { %>
                    <p style="text-align:center; color:#94a3b8; padding:20px;">No messages.</p>
                <% } %>
            </div>

            <% if (can('orders.manage')) { %>
                <form method="POST" action="/admin/chats/<%= convo._id %>/reply"
                      style="display:flex; gap:10px; margin-top:14px; border-top:1px solid #eef2f6; padding-top:14px;">
                    <input type="text" name="text" required maxlength="2000" placeholder="Type your reply as <%= (typeof adminName !== 'undefined' && adminName) ? adminName : 'Team' %>..."
                           style="flex:1; padding:10px 14px; border:1px solid #ddd; border-radius:8px; font-size:13.5px; font-family:inherit;">
                    <button type="submit" class="primary-button">
                        <i class="fa-solid fa-paper-plane"></i> Send Reply
                    </button>
                </form>
                <p style="font-size:12px; color:#94a3b8; margin-top:8px;">
                    Sending a reply switches this conversation to <strong>Team</strong> mode — the chatbot stops answering until you resume it.
                </p>
            <% } %>

        </section>

    </main>

</div>

<%- include("partials/footer") %>

<script>
    (function () {
        var lastCount = <%= messages.length %>;
        var convoId = "<%= convo._id %>";
        var displayName = <%- JSON.stringify(convo.displayName).replace(/</g, "\\u003c") %>;

        function esc(s) {
            var d = document.createElement("div");
            d.textContent = s == null ? "" : String(s);
            return d.innerHTML;
        }

        function timeOf(iso) {
            var d = new Date(iso);
            return d.toLocaleDateString("en-GB") + ", " + d.toLocaleTimeString("en-GB");
        }

        function updateMode(mode) {
            var line = document.getElementById("chat-mode-line");
            if (line) {
                line.innerHTML = mode === "human"
                    ? 'Mode: <strong style="color:#b45309;">Team</strong> — the bot is paused for this conversation.'
                    : 'Mode: <strong style="color:#1d6fa5;">Bot</strong> — the assistant is answering automatically. Your first reply will take over.';
            }

            var modeInput = document.getElementById("chat-mode-input");
            var modeText = document.getElementById("chat-mode-btn-text");

            if (modeInput) modeInput.value = mode === "human" ? "bot" : "human";
            if (modeText) modeText.textContent = mode === "human" ? "Resume Bot" : "Pause Bot";
        }

        async function poll() {
            if (document.hidden) return;
            try {
                var res = await fetch("/admin/chats/" + convoId + "/messages", { headers: { "Accept": "application/json" } });
                var data = await res.json();
                if (!data.ok) return;

                updateMode(data.mode);

                var thread = document.getElementById("chat-thread");
                if (data.messages.length === lastCount) return;

                thread.innerHTML = "";
                data.messages.forEach(function (m) {
                    var wrap = document.createElement("div");
                    var mine = m.sender === "admin";
                    var bg = mine ? "#e8f5ec" : (m.sender === "bot" ? "#eef2f6" : "#fff4ef");
                    wrap.style.cssText = "align-self:" + (mine ? "flex-end" : "flex-start") + ";max-width:78%;background:" + bg +
                        ";border:1px solid #e8ecf1;border-radius:12px;padding:10px 14px;";
                    var who = mine ? (m.senderName || "Team") : (m.sender === "bot" ? "Assistant" : displayName);
                    wrap.innerHTML = '<div style="font-size:11px;font-weight:700;color:#64748b;margin-bottom:4px;">' + esc(who) +
                        ' · ' + timeOf(m.at) + '</div><div style="font-size:13.5px;color:#1f2937;white-space:pre-wrap;">' + esc(m.text) + '</div>';
                    thread.appendChild(wrap);
                });

                lastCount = data.messages.length;
                thread.scrollTop = thread.scrollHeight;
                document.getElementById("chat-status").textContent = "Updated " + new Date().toLocaleTimeString("en-GB");
            } catch (e) { /* keep polling */ }
        }

        var box = document.getElementById("chat-thread");
        box.scrollTop = box.scrollHeight;
        setInterval(poll, 6000);
    })();
</script>
