<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Account - Mizan Trade</title>
    <link rel="icon" href="/images/logo.svg">
</head>
<body>

    <%- include('partials/header') %>

    <div class="container" style="max-width:560px;">

        <div class="content-card" style="text-align:center; padding:46px 26px; margin-top:30px;">

            <div style="width:72px; height:72px; border-radius:50%; background:#f4f6f9; display:inline-flex; align-items:center; justify-content:center; margin-bottom:16px;">
                <i class="fa-regular fa-user" style="font-size:30px; color:#374957;"></i>
            </div>

            <h1 style="color:#081621; font-size:21px; margin-bottom:10px;">Customer Account</h1>

            <p style="color:#777; line-height:1.7; margin-bottom:22px;">
                You can place an order without an account — just provide your name, phone and address at checkout.
                <br>Full customer login and order tracking features are coming very soon.
            </p>

            <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
                <a href="/shop" class="btn btn-primary"><i class="fa-solid fa-store"></i> Start Shopping</a>
                <a href="/cart" class="btn btn-outline"><i class="fa-solid fa-cart-shopping"></i> View Cart</a>
            </div>

            <p style="margin-top:26px; font-size:12.5px; color:#999;">
                Admin? <a href="/admin/login" style="color:#ef4a23; font-weight:600;">Admin Login</a>
            </p>

        </div>

    </div>

    <%- include('partials/footer') %>

    <script src="/js/main.js?v=2"></script>
</body>
</html>
