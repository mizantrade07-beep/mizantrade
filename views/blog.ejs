<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/seo') %>
    <link rel="icon" href="/images/logo.svg">
    <style>
        .blog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 22px;
            margin-top: 22px;
        }
        .blog-card {
            background: #fff;
            border: 1px solid #eef0f3;
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform .18s, box-shadow .18s;
            text-decoration: none;
            color: inherit;
        }
        .blog-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(0,0,0,.08);
        }
        .blog-card-img {
            width: 100%;
            height: 165px;
            object-fit: cover;
            background: #f4f6f9;
            display: block;
        }
        .blog-card-img.placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            color: #c3ccd6;
            font-size: 34px;
        }
        .blog-card-body { padding: 16px 18px 20px; }
        .blog-card-title {
            font-size: 16px;
            font-weight: 700;
            color: #081621;
            line-height: 1.4;
            margin: 0 0 8px;
        }
        .blog-card-excerpt {
            font-size: 13px;
            color: #66727d;
            line-height: 1.6;
            margin: 0 0 12px;
        }
        .blog-card-meta {
            font-size: 12px;
            color: #98a2ac;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }
        .blog-empty {
            text-align: center;
            padding: 60px 20px;
            color: #8892a0;
        }
        .blog-pagination {
            display: flex;
            gap: 8px;
            justify-content: center;
            margin: 30px 0;
            flex-wrap: wrap;
        }
        .blog-pagination a {
            min-width: 38px;
            padding: 9px 13px;
            text-align: center;
            border: 1px solid #e2e6ea;
            border-radius: 8px;
            color: #374957;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
        }
        .blog-pagination a.active {
            background: #ef4a23;
            border-color: #ef4a23;
            color: #fff;
        }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <div class="container" style="max-width:1200px;">

        <div class="breadcrumb">
            <a href="/">Home</a>
            <i class="fa-solid fa-angle-right" style="margin:0 6px; font-size:10px;"></i>
            <span>Blog</span>
        </div>

        <h1 class="page-title"><i class="fa-solid fa-newspaper"></i> Blog</h1>

        <% if (posts.length === 0) { %>
            <div class="content-card blog-empty">
                <i class="fa-solid fa-newspaper" style="font-size:40px; color:#d6dce3;"></i>
                <p style="margin-top:14px;">No blog posts have been published yet. Coming soon.</p>
            </div>
        <% } else { %>
            <div class="blog-grid">
                <% posts.forEach(function (p) { %>
                    <a href="/blog/<%= p.slug %>" class="blog-card">
                        <% if (p.coverImage) { %>
                            <img class="blog-card-img" src="<%= p.coverImage %>" alt="<%= p.title %>">
                        <% } else { %>
                            <div class="blog-card-img placeholder"><i class="fa-solid fa-image"></i></div>
                        <% } %>
                        <div class="blog-card-body">
                            <h2 class="blog-card-title"><%= p.title %></h2>
                            <% if (p.excerpt) { %>
                                <p class="blog-card-excerpt">
                                    <%= p.excerpt.length > 110 ? p.excerpt.slice(0, 110) + '…' : p.excerpt %>
                                </p>
                            <% } %>
                            <div class="blog-card-meta">
                                <span><i class="fa-regular fa-user"></i> <%= p.author || 'Mizan Trade' %></span>
                                <span><i class="fa-regular fa-calendar"></i> <%= new Date(p.publishedAt || p.createdAt).toLocaleDateString() %></span>
                                <span><i class="fa-regular fa-eye"></i> <%= p.views || 0 %></span>
                            </div>
                        </div>
                    </a>
                <% }); %>
            </div>

            <% if (totalPages > 1) { %>
                <div class="blog-pagination">
                    <% for (var i = 1; i <= totalPages; i++) { %>
                        <a href="/blog?page=<%= i %>" class="<%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                    <% } %>
                </div>
            <% } %>
        <% } %>

    </div>

    <%- include('partials/footer') %>

    <script src="/js/main.js?v=2"></script>
</body>
</html>
