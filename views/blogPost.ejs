<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/seo') %>
    <link rel="icon" href="/images/logo.svg">
    <style>
        .post-hero { width: 100%; max-height: 380px; object-fit: cover; border-radius: 12px; margin-bottom: 22px; }
        .post-content { font-size: 15px; line-height: 1.95; color: #333; }
        .post-content img { max-width: 100%; height: auto; border-radius: 8px; }
        .post-content h2, .post-content h3 { color: #081621; margin-top: 26px; }
        .post-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 22px; }
        .post-tag { background: #fff3ef; color: #ef4a23; font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 20px; }
        .post-meta { display: flex; gap: 16px; flex-wrap: wrap; color: #8892a0; font-size: 13px; margin-bottom: 18px; }
        .comment { border-bottom: 1px solid #eef0f3; padding: 16px 0; }
        .comment:last-child { border-bottom: none; }
        .comment-head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
        .comment-avatar { width: 38px; height: 38px; border-radius: 50%; background: #f4f6f9; color: #374957; display: flex; align-items: center; justify-content: center; font-weight: 700; }
        .comment-name { font-weight: 700; color: #081621; font-size: 14px; }
        .comment-date { font-size: 12px; color: #98a2ac; }
        .comment-body { font-size: 14px; color: #444; line-height: 1.7; margin: 0; }
        .comment-reply { margin-top: 10px; padding: 10px 14px; background: #f7f9fb; border-left: 3px solid #ef4a23; border-radius: 6px; font-size: 13px; color: #555; }
        .alert-note { padding: 12px 16px; border-radius: 8px; margin-bottom: 18px; font-size: 14px; }
        .alert-ok { background: #e8f6ee; color: #1e7d43; border: 1px solid #bfe6cd; }
        .alert-warn { background: #fff6e6; color: #9a6700; border: 1px solid #ffe1a8; }
        .alert-err { background: #fdecea; color: #c0392b; border: 1px solid #f5c6cb; }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <div class="container" style="max-width:860px;">

        <div class="breadcrumb">
            <a href="/">Home</a>
            <i class="fa-solid fa-angle-right" style="margin:0 6px; font-size:10px;"></i>
            <a href="/blog">Blog</a>
            <i class="fa-solid fa-angle-right" style="margin:0 6px; font-size:10px;"></i>
            <span><%= post.title.length > 40 ? post.title.slice(0,40) + '…' : post.title %></span>
        </div>

        <article class="content-card" style="padding:30px;">

            <h1 class="page-title" style="margin-top:0; line-height:1.35;"><%= post.title %></h1>

            <div class="post-meta">
                <span><i class="fa-regular fa-user"></i> <%= post.author || 'Mizan Trade' %></span>
                <span><i class="fa-regular fa-calendar"></i> <%= new Date(post.publishedAt || post.createdAt).toLocaleDateString() %></span>
                <span><i class="fa-regular fa-eye"></i> <%= post.views || 0 %> views</span>
            </div>

            <% if (post.coverImage) { %>
                <img class="post-hero" src="<%= post.coverImage %>" alt="<%= post.title %>">
            <% } %>

            <div class="post-content">
                <%- post.content %>
            </div>

            <% if (post.tags && post.tags.length) { %>
                <div class="post-tags">
                    <% post.tags.forEach(function (t) { %>
                        <span class="post-tag">#<%= t %></span>
                    <% }); %>
                </div>
            <% } %>

        </article>


        <!-- ===== কমেন্ট সেকশন ===== -->
        <div class="content-card" style="padding:26px 30px; margin-top:22px;">

            <h3 style="color:#081621; margin:0 0 16px; font-size:17px;">
                <i class="fa-solid fa-comments" style="color:#ef4a23;"></i>
                Comments (<%= comments.length %>)
            </h3>

            <% if (typeof commentMessage !== 'undefined' && commentMessage === 'pending') { %>
                <div class="alert-note alert-ok">
                    <i class="fa-solid fa-circle-check"></i> Your comment has been submitted. It will appear after admin approval.
                </div>
            <% } else if (commentMessage === 'closed') { %>
                <div class="alert-note alert-warn">
                    <i class="fa-solid fa-lock"></i> Comments are closed on this post.
                </div>
            <% } else if (commentMessage === 'error') { %>
                <div class="alert-note alert-err">
                    <i class="fa-solid fa-circle-exclamation"></i> Could not submit the comment. Please fill in your name and comment.
                </div>
            <% } %>

            <% if (comments.length === 0) { %>
                <p style="color:#8892a0; font-size:14px;">No approved comments yet. Be the first to comment!</p>
            <% } else { %>
                <% comments.forEach(function (c) { %>
                    <div class="comment">
                        <div class="comment-head">
                            <div class="comment-avatar"><%= c.name.charAt(0).toUpperCase() %></div>
                            <div>
                                <div class="comment-name"><%= c.name %></div>
                                <div class="comment-date"><%= new Date(c.createdAt).toLocaleString() %></div>
                            </div>
                        </div>
                        <p class="comment-body"><%= c.content %></p>
                        <% if (c.adminReply) { %>
                            <div class="comment-reply">
                                <strong style="color:#ef4a23;"><i class="fa-solid fa-reply"></i> Mizan Trade:</strong>
                                <%= c.adminReply %>
                            </div>
                        <% } %>
                    </div>
                <% }); %>
            <% } %>

            <% if (post.allowComments !== false) { %>
                <form action="/blog/<%= post.slug %>/comment" method="POST" style="margin-top:24px; border-top:1px solid #eef0f3; padding-top:22px;">
                    <h4 style="color:#081621; margin:0 0 14px; font-size:15px;">Leave a Comment</h4>

                    <% if (!customer) { %>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Your Name <span class="req">*</span></label>
                                <input type="text" name="name" class="form-control" required>
                            </div>
                            <div class="form-group">
                                <label>Email (optional)</label>
                                <input type="email" name="email" class="form-control">
                            </div>
                        </div>
                    <% } else { %>
                        <p style="font-size:13px; color:#66727d; margin-bottom:12px;">
                            Commenting as: <strong><%= customer.name %></strong>
                        </p>
                    <% } %>

                    <div class="form-group">
                        <label>Comment <span class="req">*</span></label>
                        <textarea name="content" class="form-control" rows="4" required style="min-height:90px;"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary" style="margin-top:6px;">
                        <i class="fa-solid fa-paper-plane"></i> Submit Comment
                    </button>
                    <p style="font-size:12px; color:#98a2ac; margin-top:10px;">
                        Comments are published after admin approval.
                    </p>
                </form>
            <% } %>

        </div>

    </div>

    <%- include('partials/footer') %>

    <script src="/js/main.js?v=2"></script>
</body>
</html>
