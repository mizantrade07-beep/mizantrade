<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="/images/logo.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Partner Login - Mizan Trade</title>
    <%- include('account/authStyles') %>
</head>
<body>

    <%- include('partials/header') %>

    <%
        var errorText = (typeof message !== 'undefined' && message) ? message : '';
        var noticeText = (typeof notice !== 'undefined' && notice) ? notice : '';
        var emailVal = (typeof email !== 'undefined' && email) ? email : '';
    %>

    <div class="container auth-wrap">

        <div class="auth-card">

            <div class="auth-hero" style="background: linear-gradient(120deg, #081621 0%, #1f4a66 100%);">
                <div class="ah-ic"><i class="fa-solid fa-handshake"></i></div>
                <h1>Partner Login</h1>
                <p>Exclusive access to the Mizan Trade offers portal</p>
            </div>

            <div class="auth-body">

                <% if (errorText) { %>
                    <div class="auth-banner err"><i class="fa-solid fa-circle-exclamation"></i> <%= errorText %></div>
                <% } %>
                <% if (noticeText) { %>
                    <div class="auth-banner ok"><i class="fa-solid fa-circle-check"></i> <%= noticeText %></div>
                <% } %>

                <form action="/partner/login" method="POST">
                    <div class="auth-field">
                        <label>Business E-Mail</label>
                        <input type="email" name="email" class="auth-input" placeholder="business@company.com"
                               value="<%= emailVal %>" required>
                    </div>
                    <div class="auth-field">
                        <label>Password</label>
                        <div class="pw-wrap">
                            <input type="password" name="password" id="partnerPassword" class="auth-input" placeholder="Your password" required>
                            <button type="button" class="pw-toggle" data-target="partnerPassword"><i class="fa-regular fa-eye"></i></button>
                        </div>
                    </div>
                    <button type="submit" class="auth-btn">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i> Log In to Offers
                    </button>
                </form>

                <a href="/become-a-partner" class="auth-create">
                    <i class="fa-solid fa-user-plus"></i> Become a Partner
                </a>

                <p class="auth-note">
                    Logins are created after your application is <strong>approved</strong> by our team.<br>
                    Regular customer? <a href="/login" class="auth-link">Log in here</a> instead —
                    customer accounts cannot access this portal.
                </p>

            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        (function () {
            document.querySelectorAll('.pw-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(btn.getAttribute('data-target'));
                    if (!input) return;
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.innerHTML = show ? '<i class="fa-regular fa-eye-slash"></i>' : '<i class="fa-regular fa-eye"></i>';
                });
            });
        })();
    </script>
    <script src="/js/main.js?v=4"></script>
</body>
</html>
