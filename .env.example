NODE_ENV=development

PORT=5000

MONGO_URI=

SESSION_SECRET=

ADMIN_EMAIL=

ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SITE_URL=http://localhost:5000

# ------------------------------------------------------
# Customer login OTP
# E-mail OTP uses SMTP; mobile OTP uses WhatsApp Cloud API.
# Set EMAIL_MODE=console for local testing (codes are logged, not sent).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=1
# SMTP_PASS must be a Google App Password, not the normal Gmail password.
# Account signup uses e-mail OTP when SMTP is configured. Without SMTP the
# account is created immediately (unverified) so customers can still log in.
# ------------------------------------------------------
EMAIL_MODE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v25.0
# Approved Meta Authentication template for OTP delivery. Cloud API rejects
# free-form text outside a customer's 24-hour window, so production OTPs need
# a template whose body takes the code as {{1}}. Leave blank only for testing.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en_US

# ------------------------------------------------------
# Mobile OTP by SMS (bulksmsbd.net)
# Copy SMS_API_KEY from the bulksmsbd.net Developer page and use the exact
# approved sender id. The gateway needs an active account with balance.
# Set SMS_MODE=console for local testing (codes are logged, not sent).
# SMS_API_URL is optional; leave empty for https://bulksmsbd.net/api/smsapi.
# ------------------------------------------------------
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=
SMS_MODE=

# ------------------------------------------------------
# Social login
# Redirect URI to register with each provider:
#   {SITE_URL}/auth/google/callback
#   {SITE_URL}/auth/facebook/callback
#   {SITE_URL}/auth/tiktok/callback
# Buttons stay visible; unconfigured providers show a notice.
# ------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional AI brain for the website Live Chat (ChatGPT/Gemini-like answers).
# Leave empty to use only the built-in catalogue engine (no external calls).
# When set, the AI answers every visitor message in the customer's own
# language (English / Bangla / Banglish), using live product, FAQ and policy
# data from the site. Any OpenAI-compatible API works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini